<header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Logo ve Başlık -->
        <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-xl bg-orange-600 flex items-center justify-center text-white shadow-lg shadow-orange-600/30 group-hover:scale-105 transition-transform">
                <i class="fa-solid fa-wrench text-lg"></i>
            </div>
            <div>
                <span class="text-xl font-black tracking-tight text-white">Oto<span class="text-orange-500">Takip</span></span>
                <span class="hidden sm:inline-block ml-2 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider bg-orange-500/10 text-orange-400 border border-orange-500/20 rounded-md">Usta Masası</span>
            </div>
        </a>

        <!-- Sağ Menü: Oturum Kontrolü -->
        <div class="flex items-center gap-4">
            <% if (typeof currentWorkshop !== 'undefined' && currentWorkshop) { %>
                <!-- Giriş Yapmış Usta -->
                <a href="/dashboard" class="text-sm font-medium text-slate-300 hover:text-white transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-gauge text-orange-500"></i>
                    <span>Liftler</span>
                </a>

                <a href="/arsiv" class="text-sm font-medium text-slate-300 hover:text-white transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-box-archive text-amber-500"></i>
                    <span>Arşiv</span>
                </a>

                <div class="h-4 w-px bg-slate-800"></div>

                <div class="flex items-center gap-3">
                    <div class="hidden sm:block text-right">
                        <div class="text-sm font-semibold text-white"><%= currentWorkshop.workshop_name %></div>
                        <div class="text-xs text-slate-400"><%= currentWorkshop.owner_name %></div>
                    </div>
                    <a href="/logout" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-rose-500/20 text-slate-300 hover:text-rose-400 border border-slate-700 hover:border-rose-500/30 transition-all flex items-center gap-1.5" title="Çıkış Yap">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span class="hidden sm:inline">Çıkış</span>
                    </a>
                </div>
            <% } else { %>
                <!-- Giriş Yapmamış Ziyaretçi -->
                <a href="/login" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors">Usta Girişi</a>
                <a href="/register" class="px-4 py-2 text-sm font-semibold rounded-xl bg-orange-600 hover:bg-orange-500 text-white shadow-lg shadow-orange-600/30 transition-all">
                    Servis Kaydı Aç
                </a>
            <% } %>
        </div>

    </div>
</header>
