<div class="space-y-6 sm:space-y-8">
    
    <!-- Üst Başlık ve Hızlı Aksiyon Barı -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-display font-extrabold text-gray-900 tracking-tight flex items-center gap-3">
                <span>Garaj Yönetimi</span>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Canlı Akış
                </span>
            </h1>
            <p class="text-sm text-gray-500 mt-1">Aktif istasyonlar ve araç durumlarının anlık takibi.</p>
        </div>

        <button 
            onclick="document.getElementById('new-car-modal').classList.remove('hidden')"
            class="bg-gray-900 hover:bg-black text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition-all shadow-xs whitespace-nowrap cursor-pointer flex items-center justify-center gap-2 self-start sm:self-auto"
        >
            <i class="fa-solid fa-plus text-xs"></i>
            <span>Yeni Araç Kabul</span>
        </button>
    </div>

    <!-- İstatistik Özet Kartları (Açık ve Modern) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex items-center justify-between">
            <div>
                <div class="text-xs font-bold uppercase tracking-wider text-gray-400">Liftlerdeki Araçlar</div>
                <div class="text-3xl font-display font-extrabold text-gray-900 mt-1"><%= cars.length %></div>
            </div>
            <div class="w-11 h-11 rounded-xl bg-sky-50 text-sky-600 border border-sky-100 flex items-center justify-center text-lg">
                <i class="fa-solid fa-car"></i>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-amber-200/70 shadow-xs flex items-center justify-between">
            <div>
                <div class="text-xs font-bold uppercase tracking-wider text-amber-600">Onay Bekleyenler</div>
                <div class="text-3xl font-display font-extrabold text-amber-700 mt-1">
                    <%= cars.filter(c => c.hasPendingApproval).length %>
                </div>
            </div>
            <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 border border-amber-200 flex items-center justify-center text-lg">
                <i class="fa-brands fa-whatsapp"></i>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-emerald-200/70 shadow-xs flex items-center justify-between">
            <div>
                <div class="text-xs font-bold uppercase tracking-wider text-emerald-600">Teslimata Hazır</div>
                <div class="text-3xl font-display font-extrabold text-emerald-700 mt-1">
                    <%= cars.filter(c => c.status === 'READY').length %>
                </div>
            </div>
            <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center text-lg">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>
    </div>

    <!-- Liftler / İstasyon Kartları Izgarası (Mockup Birebir 4'lü Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
        <% if (cars && cars.length > 0) { %>
            <% cars.forEach(car => { %>
                <div 
                    id="car-card-<%= car.id %>"
                    class="bg-white border border-gray-200/80 rounded-2xl flex flex-col shadow-xs overflow-hidden transition-all hover:border-gray-300"
                >
                    <!-- Üst İstasyon Başlığı & Durum Rozeti -->
                    <div class="px-5 py-3.5 border-b border-gray-100 bg-gray-50/60 flex justify-between items-center">
                        <div class="font-bold text-gray-900 text-sm">
                            <%= car.station || 'İstasyon' %>
                        </div>
                        
                        <% if (car.hasPendingApproval) { %>
                            <span class="badge badge-amber animate-pulse">Onay Bekliyor</span>
                        <% } else if (car.status === 'REPAIRING') { %>
                            <span class="badge badge-blue">Onarımda</span>
                        <% } else if (car.status === 'READY') { %>
                            <span class="badge badge-green">Hazır</span>
                        <% } else if (car.status === 'RECEIVED') { %>
                            <span class="badge badge-blue">Kabul Edildi</span>
                        <% } else if (car.status === 'INSPECTING') { %>
                            <span class="badge bg-purple-50 text-purple-700 border border-purple-200">Teşhiste</span>
                        <% } else if (car.status === 'TESTING') { %>
                            <span class="badge bg-indigo-50 text-indigo-700 border border-indigo-200">Testte</span>
                        <% } else { %>
                            <span class="badge bg-gray-100 text-gray-700">İşlemde</span>
                        <% } %>
                    </div>

                    <!-- Kart İçeriği -->
                    <div class="p-5 flex-1 flex flex-col">
                        <!-- Plaka -->
                        <div class="plate mb-3.5">
                            <span class="plate-tr">TR</span>
                            <span class="plate-num"><%= car.plate %></span>
                        </div>
                        
                        <!-- Model -->
                        <div class="font-display font-bold text-gray-900 text-lg truncate">
                            <%= car.car_model %>
                        </div>
                        
                        <!-- Müşteri -->
                        <div class="text-xs text-gray-500 mt-1 flex items-center gap-1.5 truncate">
                            <span><i class="fa-solid fa-user text-gray-400 mr-1"></i><%= car.customer_name || 'Müşteri' %></span>
                            <span>•</span>
                            <span><%= car.customer_phone %></span>
                        </div>

                        <!-- Şikayet / Arıza Notu -->
                        <div class="text-xs sm:text-sm text-gray-500 mt-2.5 leading-relaxed line-clamp-2">
                            <%= car.initial_complaint || 'Arıza tespiti ve periyodik kontrol yapılıyor.' %>
                        </div>

                        <!-- WhatsApp Onay Durumu Rozeti -->
                        <div id="approval-badge-<%= car.id %>" class="mt-4">
                            <% if (car.hasPendingApproval) { %>
                                <div class="p-2.5 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-800 text-xs font-semibold flex items-center justify-between">
                                    <span class="flex items-center gap-1.5">
                                        <i class="fa-brands fa-whatsapp text-sm text-emerald-600"></i>
                                        WhatsApp Onayı
                                    </span>
                                    <span class="text-[10px] bg-amber-500 text-white px-1.5 py-0.5 rounded font-bold">BEKLEMEDE</span>
                                </div>
                            <% } else if (car.hasApproved) { %>
                                <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-200/80 text-emerald-800 text-xs font-semibold flex items-center justify-between">
                                    <span class="flex items-center gap-1.5">
                                        <i class="fa-solid fa-check-double text-sm text-emerald-600"></i>
                                        Parça Onaylandı
                                    </span>
                                    <span class="text-[10px] bg-emerald-600 text-white px-1.5 py-0.5 rounded font-bold">MONTAJ</span>
                                </div>
                            <% } %>
                        </div>

                        <!-- Alt Buton: İşlem Masası -->
                        <div class="mt-5 pt-4 border-t border-gray-100 mt-auto">
                            <a 
                                href="/arac/<%= car.id %>" 
                                class="w-full bg-white border border-gray-200 hover:bg-gray-50 text-gray-800 px-4 py-2.5 rounded-xl font-semibold text-sm transition-all flex items-center justify-center gap-2 cursor-pointer shadow-xs"
                            >
                                <span>İşlem Masası & Detay</span>
                                <i class="fa-solid fa-arrow-right text-xs text-gray-400"></i>
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>

        <!-- Boş İstasyon Kartları (Toplamda en az 4 slot tamamlamak için) -->
        <% const emptySlots = Math.max(0, 4 - (cars ? cars.length : 0)); %>
        <% for (let i = 1; i <= emptySlots; i++) { %>
            <div 
                onclick="document.getElementById('new-car-modal').classList.remove('hidden')"
                class="bg-white/40 border-2 border-dashed border-gray-200 hover:border-gray-300 rounded-2xl flex flex-col items-center justify-center p-6 text-center cursor-pointer transition-all min-h-[300px] group"
            >
                <div class="w-12 h-12 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-400 group-hover:text-gray-600 transition-colors mb-3 shadow-xs">
                    <i class="fa-solid fa-plus"></i>
                </div>
                <div class="font-display font-bold text-gray-800 text-base">Boş İstasyon</div>
                <div class="text-xs text-gray-400 mt-1">Yeni araç kabul etmek için tıklayın.</div>
            </div>
        <% } %>
    </div>

</div>

<!-- YENİ ARAÇ KABUL MODALI (Modern ve Açık Tema) -->
<div id="new-car-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 hidden">
    <div class="w-full max-w-lg bg-white border border-gray-200 rounded-3xl p-6 sm:p-8 shadow-2xl relative">
        
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-100">
            <h2 class="text-lg sm:text-xl font-display font-extrabold text-gray-900 flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-car"></i>
                </div>
                <span>Yeni Araç Kabulü (İş Emri)</span>
            </h2>
            <button 
                onclick="document.getElementById('new-car-modal').classList.add('hidden')"
                class="w-8 h-8 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-500 hover:text-black flex items-center justify-center transition-colors cursor-pointer"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="/arac/yeni" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Plaka *</label>
                    <input 
                        type="text" 
                        name="plate" 
                        required 
                        placeholder="34 BCD 128" 
                        class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm font-mono font-bold uppercase focus:bg-white focus:border-sky-600 focus:outline-none transition-colors"
                    >
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Araç Modeli *</label>
                    <input 
                        type="text" 
                        name="car_model" 
                        required 
                        placeholder="Dacia Sandero 1.0 TCE" 
                        class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm focus:bg-white focus:border-sky-600 focus:outline-none transition-colors"
                    >
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Müşteri Telefonu (WhatsApp) *</label>
                    <input 
                        type="text" 
                        name="customer_phone" 
                        required 
                        placeholder="0532 111 22 33" 
                        class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm focus:bg-white focus:border-sky-600 focus:outline-none transition-colors"
                    >
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Müşteri Adı Soyadı</label>
                    <input 
                        type="text" 
                        name="customer_name" 
                        placeholder="Mehmet Yılmaz" 
                        class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm focus:bg-white focus:border-sky-600 focus:outline-none transition-colors"
                    >
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Lift / İstasyon</label>
                    <select name="station" class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm focus:bg-white focus:border-sky-600 focus:outline-none transition-colors">
                        <option value="İstasyon 01 Mekanik">İstasyon 01 (Mekanik)</option>
                        <option value="İstasyon 02 Ağır Bakım">İstasyon 02 (Ağır Bakım)</option>
                        <option value="İstasyon 03 Yıkama/Test">İstasyon 03 (Yıkama & Test)</option>
                        <option value="İstasyon 04 Genel">İstasyon 04 (Genel)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Tahmini Teslimat</label>
                    <input 
                        type="text" 
                        name="estimated_delivery" 
                        placeholder="Bugün 17:30" 
                        class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm focus:bg-white focus:border-sky-600 focus:outline-none transition-colors"
                    >
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Müşteri Şikayeti / Arıza Notu</label>
                <textarea 
                    name="initial_complaint" 
                    rows="2" 
                    placeholder="Ön takımdan lokurtu sesi geliyor, yağ kaçağı var..." 
                    class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 text-sm focus:bg-white focus:border-sky-600 focus:outline-none transition-colors"
                ></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                <button 
                    type="button" 
                    onclick="document.getElementById('new-car-modal').classList.add('hidden')"
                    class="px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-xs transition-colors cursor-pointer"
                >
                    Vazgeç
                </button>
                <button 
                    type="submit" 
                    class="bg-gray-900 hover:bg-black text-white px-5 py-2.5 rounded-xl font-semibold text-xs shadow-xs transition-all cursor-pointer"
                >
                    İş Emrini Başlat
                </button>
            </div>
        </form>

    </div>
</div>
