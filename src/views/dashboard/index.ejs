<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Üst Başlık ve Hızlı Aksiyon Barı -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white flex items-center gap-3">
                <span>Lift Kontrol Paneli</span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                    Canlı Akış Aktif
                </span>
            </h1>
            <p class="text-sm text-slate-400 mt-1">Atölyedeki liftlerin doluluk durumu ve WhatsApp onay hareketleri</p>
        </div>

        <button 
            onclick="document.getElementById('new-car-modal').classList.remove('hidden')"
            class="px-5 py-3 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-bold text-sm shadow-lg shadow-orange-600/30 transition-all flex items-center justify-center gap-2 self-start sm:self-auto"
        >
            <i class="fa-solid fa-plus text-xs"></i>
            <span>Yeni Araç Kabul Et</span>
        </button>
    </div>

    <!-- İstatistik Özet Kartları -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Liftlerdeki Araçlar</div>
                <div class="text-2xl font-black text-white mt-1"><%= cars.length %></div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-lg">
                <i class="fa-solid fa-car"></i>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Onay Bekleyenler</div>
                <div class="text-2xl font-black text-amber-400 mt-1">
                    <%= cars.filter(c => c.hasPendingApproval).length %>
                </div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-lg">
                <i class="fa-brands fa-whatsapp"></i>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Teslimata Hazır</div>
                <div class="text-2xl font-black text-emerald-400 mt-1">
                    <%= cars.filter(c => c.status === 'READY').length %>
                </div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-lg">
                <i class="fa-solid fa-circle-check"></i>
            </div>
        </div>
    </div>

    <!-- Liftler / Araç Kartları Izgarası -->
    <% if (cars.length === 0) { %>
        <div class="text-center py-16 px-4 rounded-3xl bg-slate-900/40 border border-slate-800/80">
            <div class="w-16 h-16 rounded-3xl bg-slate-800 flex items-center justify-center mx-auto mb-4 text-slate-500 text-2xl">
                <i class="fa-solid fa-wrench"></i>
            </div>
            <h3 class="text-lg font-bold text-white">Şu an liftlerde aktif araç yok</h3>
            <p class="text-sm text-slate-400 max-w-sm mx-auto mt-1 mb-6">İş emri açarak araç kabulüne başlayabilirsiniz.</p>
            <button 
                onclick="document.getElementById('new-car-modal').classList.remove('hidden')"
                class="px-5 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-semibold text-sm transition-all"
            >
                İlk Aracı Ekle
            </button>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% cars.forEach(car => { %>
                <div 
                    id="car-card-<%= car.id %>"
                    class="rounded-3xl bg-slate-900 border border-slate-800 p-6 flex flex-col justify-between hover:border-slate-700 transition-all shadow-xl relative overflow-hidden group"
                >
                    <!-- Üst: İstasyon ve Plaka -->
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-4">
                            <span class="px-3 py-1 rounded-lg bg-slate-800 text-xs font-bold text-slate-300 border border-slate-700">
                                <i class="fa-solid fa-arrow-up-from-bracket mr-1 text-orange-500"></i>
                                <%= car.station || 'Lift' %>
                            </span>

                            <!-- Plaka Tasarımı (Türk Plaka Formatı) -->
                            <div class="inline-flex items-center bg-white text-black font-mono font-black px-2.5 py-1 rounded-md border-2 border-slate-700 tracking-wider text-sm shadow">
                                <span class="bg-blue-700 text-white text-[9px] px-1 py-0.5 rounded -ml-2 mr-1.5 font-sans font-bold">TR</span>
                                <%= car.plate %>
                            </div>
                        </div>

                        <!-- Araç Modeli ve Müşteri -->
                        <h3 class="text-lg font-bold text-white group-hover:text-orange-400 transition-colors">
                            <%= car.car_model %>
                        </h3>
                        <div class="text-xs text-slate-400 mt-1 flex items-center gap-2">
                            <span><i class="fa-solid fa-user text-slate-500 mr-1"></i><%= car.customer_name || 'Müşteri' %></span>
                            <span>•</span>
                            <span><i class="fa-solid fa-phone text-slate-500 mr-1"></i><%= car.customer_phone %></span>
                        </div>

                        <!-- Müşteri Şikayeti -->
                        <% if (car.initial_complaint) { %>
                            <div class="mt-3 p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 text-xs text-slate-300 italic line-clamp-2">
                                "<%= car.initial_complaint %>"
                            </div>
                        <% } %>
                    </div>

                    <!-- Alt: Durum ve Onay Rozetleri -->
                    <div class="mt-6 pt-4 border-t border-slate-800/80 space-y-3">
                        
                        <!-- Aşama Rozeti -->
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-400 font-medium">Aşama:</span>
                            <% if (car.status === 'RECEIVED') { %>
                                <span class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-400 font-semibold border border-blue-500/20">Kabul Edildi</span>
                            <% } else if (car.status === 'INSPECTING') { %>
                                <span class="px-2.5 py-1 rounded-lg bg-purple-500/10 text-purple-400 font-semibold border border-purple-500/20">Teşhiste</span>
                            <% } else if (car.status === 'REPAIRING') { %>
                                <span class="px-2.5 py-1 rounded-lg bg-orange-500/10 text-orange-400 font-semibold border border-orange-500/20">Onarımda</span>
                            <% } else if (car.status === 'READY') { %>
                                <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 font-semibold border border-emerald-500/20">Teslimata Hazır</span>
                            <% } %>
                        </div>

                        <!-- WhatsApp Onay Durumu Rozeti -->
                        <div id="approval-badge-<%= car.id %>">
                            <% if (car.hasPendingApproval) { %>
                                <div class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold flex items-center justify-between animate-pulse">
                                    <span class="flex items-center gap-1.5">
                                        <i class="fa-brands fa-whatsapp text-sm"></i>
                                        WhatsApp Onayı Bekliyor
                                    </span>
                                    <span class="text-[10px] bg-amber-500 text-slate-950 px-1.5 py-0.5 rounded font-bold">BEKLEMEDE</span>
                                </div>
                            <% } else if (car.hasApproved) { %>
                                <div class="p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold flex items-center justify-between">
                                    <span class="flex items-center gap-1.5">
                                        <i class="fa-solid fa-check-double text-sm"></i>
                                        Parça Onaylandı
                                    </span>
                                    <span class="text-[10px] bg-emerald-500 text-slate-950 px-1.5 py-0.5 rounded font-bold">MONTAJA GEÇ</span>
                                </div>
                            <% } %>
                        </div>

                        <!-- Detay Masasına Git Butonu -->
                        <a 
                            href="/arac/<%= car.id %>" 
                            class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-orange-600 text-slate-200 hover:text-white font-semibold text-xs transition-all flex items-center justify-center gap-2"
                        >
                            <span>İşlem Masası & Detay</span>
                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </a>

                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>

</div>

<!-- YENİ ARAÇ KABUL MODALI -->
<div id="new-car-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 hidden">
    <div class="w-full max-w-lg bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative">
        
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-car text-orange-500"></i>
                <span>Yeni Araç Kabulü (İş Emri)</span>
            </h2>
            <button 
                onclick="document.getElementById('new-car-modal').classList.add('hidden')"
                class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center transition-colors"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="/arac/yeni" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Plaka *</label>
                    <input type="text" name="plate" required placeholder="34 BCD 128" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-orange-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Araç Modeli *</label>
                    <input type="text" name="car_model" required placeholder="Dacia Sandero 1.0 TCE" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-orange-500 focus:outline-none">
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Müşteri Telefonu *</label>
                    <input type="text" name="customer_phone" required placeholder="0532 111 22 33" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-orange-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Müşteri Adı</label>
                    <input type="text" name="customer_name" placeholder="Mehmet Yılmaz" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-orange-500 focus:outline-none">
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Lift / İstasyon</label>
                    <select name="station" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-orange-500 focus:outline-none">
                        <option value="Lift 1">Lift 1</option>
                        <option value="Lift 2">Lift 2</option>
                        <option value="Lift 3">Lift 3</option>
                        <option value="Lift 4">Lift 4</option>
                        <option value="Genel Bakım">Genel Bakım</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Tahmini Teslimat</label>
                    <input type="text" name="estimated_delivery" placeholder="Bugün 17:30" class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-orange-500 focus:outline-none">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Müşteri Şikayeti / Arıza Notu</label>
                <textarea name="initial_complaint" rows="2" placeholder="Ön takımdan lokurtu sesi geliyor..." class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-orange-500 focus:outline-none"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                <button 
                    type="button" 
                    onclick="document.getElementById('new-car-modal').classList.add('hidden')"
                    class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm transition-colors"
                >
                    Vazgeç
                </button>
                <button 
                    type="submit" 
                    class="px-5 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-semibold text-sm shadow-lg shadow-orange-600/30 transition-all"
                >
                    İş Emrini Başlat
                </button>
            </div>
        </form>

    </div>
</div>
