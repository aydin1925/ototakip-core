<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Geri Dön ve Başlık Barı -->
    <div class="flex items-center justify-between gap-4 mb-6">
        <a href="/dashboard" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-400 hover:text-white transition-colors">
            <i class="fa-solid fa-arrow-left text-xs"></i>
            <span>Liftlere Geri Dön</span>
        </a>

        <!-- Türk Plakası Tasarımı -->
        <div class="inline-flex items-center bg-white text-black font-mono font-black px-3 py-1 rounded-md border-2 border-slate-700 tracking-wider text-base shadow">
            <span class="bg-blue-700 text-white text-[10px] px-1.5 py-0.5 rounded -ml-2.5 mr-2 font-sans font-bold">TR</span>
            <%= vehicle.plate %>
        </div>
    </div>

    <!-- Üst Araç Bilgi Kartı -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl mb-8 relative overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div>
                <span class="px-3 py-1 rounded-lg bg-orange-500/10 text-orange-400 text-xs font-bold border border-orange-500/20">
                    <i class="fa-solid fa-arrow-up-from-bracket mr-1"></i> <%= vehicle.station || 'Lift 1' %>
                </span>
                <h1 class="text-2xl sm:text-3xl font-black text-white mt-3"><%= vehicle.car_model %></h1>
                <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400 mt-2">
                    <span><i class="fa-solid fa-user text-slate-500 mr-1.5"></i><%= vehicle.customer_name || 'Müşteri Belirtilmedi' %></span>
                    <span>•</span>
                    <span><i class="fa-brands fa-whatsapp text-emerald-500 mr-1.5"></i><%= vehicle.customer_phone %></span>
                    <% if (vehicle.mileage) { %>
                        <span>•</span>
                        <span><i class="fa-solid fa-gauge-high text-slate-500 mr-1.5"></i><%= vehicle.mileage.toLocaleString('tr-TR') %> KM</span>
                    <% } %>
                </div>
            </div>

            <!-- Tahmini Teslimat -->
            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 self-start md:self-auto text-right">
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Hedef Teslimat</div>
                <div class="text-base font-bold text-white mt-1">
                    <%= vehicle.estimated_delivery || 'Belirlenmedi' %>
                </div>
            </div>
        </div>

        <!-- Müşteri Şikayeti Kutusu -->
        <% if (vehicle.initial_complaint) { %>
            <div class="mt-6 p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 text-sm text-slate-300">
                <span class="font-bold text-orange-400">Müşteri Şikayeti:</span> <%= vehicle.initial_complaint %>
            </div>
        <% } %>
    </div>

    <!-- 4 AŞAMALI DURUM İLERLETİCİ (STEPPER) -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl mb-8">
        <h2 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
            <i class="fa-solid fa-list-check text-orange-500"></i>
            <span>Tamir Süreci ve Aşama Yönetimi</span>
        </h2>

        <!-- Aşamaların Görsel Akışı -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
            <% 
                const stages = [
                    { key: 'RECEIVED', label: '1. Kabul Edildi', icon: 'fa-clipboard-check' },
                    { key: 'INSPECTING', label: '2. Teşhiste', icon: 'fa-magnifying-glass' },
                    { key: 'REPAIRING', label: '3. Onarımda', icon: 'fa-wrench' },
                    { key: 'READY', label: '4. Teslimata Hazır', icon: 'fa-circle-check' }
                ];
                const stageOrder = ['RECEIVED', 'INSPECTING', 'REPAIRING', 'READY', 'DELIVERED'];
                const currentIndex = stageOrder.indexOf(vehicle.status);
            %>

            <% stages.forEach((s, idx) => { 
                const isPassed = currentIndex >= idx;
                const isCurrent = vehicle.status === s.key;
            %>
                <div class="p-4 rounded-2xl border text-center transition-all <%= isCurrent ? 'bg-orange-600/10 border-orange-500 text-orange-400 ring-2 ring-orange-500/20' : (isPassed ? 'bg-slate-950 border-emerald-500/30 text-emerald-400' : 'bg-slate-950/50 border-slate-800 text-slate-500') %>">
                    <i class="fa-solid <%= s.icon %> text-xl mb-2"></i>
                    <div class="text-xs font-bold"><%= s.label %></div>
                    <div class="text-[10px] mt-1 font-semibold uppercase tracking-wider">
                        <%= isCurrent ? 'ŞU ANKİ AŞAMA' : (isPassed ? 'TAMAMLANDI' : 'BEKLİYOR') %>
                    </div>
                </div>
            <% }); %>
        </div>

        <!-- Aşama Değiştirme Butonları -->
        <form id="stage-form" action="/arac/<%= vehicle.id %>/stage" method="POST" class="flex flex-wrap items-center gap-3 pt-6 border-t border-slate-800">
            <input type="hidden" name="status" id="stage-input">

            <% if (vehicle.status === 'RECEIVED') { %>
                <button type="button" onclick="confirmStageChange('INSPECTING', 'Aracı detaylı teşhis ve arıza tespit aşamasına almak istiyor musunuz?')" class="px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all flex items-center gap-2">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Teşhise Al</span>
                </button>
            <% } else if (vehicle.status === 'INSPECTING') { %>
                <button type="button" onclick="confirmStageChange('REPAIRING', 'Parça onarımına ve montaja başlansın mı? Müşterinizin WhatsApp hattına montaj başladı bildirimi iletilecektir.')" class="px-5 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-semibold text-sm transition-all flex items-center gap-2">
                    <i class="fa-solid fa-wrench"></i>
                    <span>Onarıma Başla</span>
                </button>
            <% } else if (vehicle.status === 'REPAIRING') { %>
                <button type="button" onclick="confirmStageChange('READY', 'Araç bakım ve onarımı tamamlandı mı? Müşterinize aracın teslime hazır olduğuna dair WhatsApp mesajı iletilecektir.')" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-all flex items-center gap-2 shadow-lg shadow-emerald-600/20">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Teslimata Hazır Yap</span>
                </button>
            <% } else if (vehicle.status === 'READY') { %>
                <button type="button" onclick="confirmStageChange('DELIVERED', 'Araç müşteriye teslim edildi mi? Müşterinize teşekkür ve iyi yolculuklar mesajı iletilecektir.')" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-all flex items-center gap-2">
                    <i class="fa-solid fa-key"></i>
                    <span>Müşteriye Teslim Et</span>
                </button>
            <% } %>
        </form>
    </div>

    <!-- WHATSAPP DİJİTAL PARÇA ONAY MASASI -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-brands fa-whatsapp text-emerald-500 text-xl"></i>
                    <span>WhatsApp Parça ve Fiyat Onayları</span>
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">Müşterinin telefonundan anlık tetiklenir</p>
            </div>

            <button 
                type="button" 
                onclick="document.getElementById('new-approval-modal').classList.remove('hidden')"
                class="px-4 py-2 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-bold text-xs shadow-lg shadow-orange-600/30 transition-all flex items-center gap-2 self-start sm:self-auto"
            >
                <i class="fa-solid fa-plus text-[10px]"></i>
                <span>Yeni Parça Onay Talebi Gönder</span>
            </button>
        </div>

        <% if (!vehicle.approvals || vehicle.approvals.length === 0) { %>
            <div class="text-center py-8 px-4 rounded-2xl bg-slate-950 border border-slate-800/80 text-slate-400 text-sm">
                Bu araç için henüz parça onay talebi gönderilmemiş.
            </div>
        <% } else { %>
            <div class="space-y-4">
                <% vehicle.approvals.forEach(appr => { %>
                    <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div>
                            <div class="text-base font-bold text-white"><%= appr.part_name %></div>
                            <div class="text-sm text-slate-400 mt-1"><%= appr.note || 'Açıklama belirtilmedi' %></div>
                            <div class="text-xs text-slate-500 mt-2">
                                <i class="fa-regular fa-clock mr-1"></i>Talep Zamanı: <%= appr.requested_at %>
                            </div>
                        </div>

                        <!-- Onay Rozeti -->
                        <div>
                            <% if (appr.status === 'APPROVED') { %>
                                <div class="px-4 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-bold text-sm flex items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-emerald-500"></i>
                                    <span>MÜŞTERİ ONAYLADI</span>
                                </div>
                            <% } else if (appr.status === 'PENDING') { %>
                                <div class="px-4 py-2 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 font-bold text-sm flex items-center gap-2 animate-pulse">
                                    <i class="fa-regular fa-clock text-amber-500"></i>
                                    <span>ONAY BEKLENİYOR (WhatsApp)</span>
                                </div>
                            <% } else { %>
                                <div class="px-4 py-2 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 font-bold text-sm flex items-center gap-2">
                                    <i class="fa-solid fa-circle-xmark text-rose-500"></i>
                                    <span>MÜŞTERİ REDDETTİ</span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <!-- MÜŞTERİ WHATSAPP SORU VE YANIT GEÇMİŞİ (CANLI SOHBET) -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-comments text-cyan-400 text-xl"></i>
                    <span>Müşteri WhatsApp Sohbeti & Soru-Cevap</span>
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">Müşterinin WhatsApp'tan yazdığı sorular ve ustanın verdiği doğrudan yanıtlar</p>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-400 bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800 self-start sm:self-auto">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>WhatsApp Hattı: <%= vehicle.customer_phone %></span>
            </div>
        </div>

        <!-- Sohbet Akışı (Mesaj Baloncukları) -->
        <div id="chat-messages-container" class="space-y-4 max-h-96 overflow-y-auto pr-2 mb-6 p-4 rounded-2xl bg-slate-950/80 border border-slate-800/80">
            <% if (!vehicle.messages || vehicle.messages.length === 0) { %>
                <div id="no-messages-placeholder" class="text-center py-10 px-4 text-slate-400 text-sm">
                    <i class="fa-regular fa-comment-dots text-3xl text-slate-600 mb-2 block"></i>
                    Bu araç için henüz müşteri mesajı bulunmuyor.<br>
                    <span class="text-xs text-slate-500">Müşteri WhatsApp'tan soru yazdığında anında burada belirecektir.</span>
                </div>
            <% } else { %>
                <% vehicle.messages.forEach(msg => { %>
                    <% if (msg.sender_type === 'CUSTOMER') { %>
                        <!-- Müşteri Mesajı (Solda, Koyu Gri Balon) -->
                        <div class="flex items-start gap-3 max-w-xl">
                            <div class="w-8 h-8 rounded-full bg-slate-800 text-slate-300 flex items-center justify-center flex-shrink-0 text-xs border border-slate-700">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div class="bg-slate-800/90 border border-slate-700/60 rounded-2xl rounded-tl-sm p-4 text-sm text-slate-200 shadow-md">
                                <div class="flex items-center justify-between gap-4 mb-1 text-[11px] text-slate-400 font-semibold">
                                    <span class="text-emerald-400"><%= vehicle.customer_name %> (Müşteri)</span>
                                    <span><%= msg.created_at %></span>
                                </div>
                                <p class="leading-relaxed"><%= msg.message_text %></p>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Usta Yanıtı (Sağda, Turuncu Vurgulu Balon) -->
                        <div class="flex items-start justify-end gap-3 max-w-xl ml-auto">
                            <div class="bg-orange-950/40 border border-orange-500/30 rounded-2xl rounded-tr-sm p-4 text-sm text-orange-100 shadow-md">
                                <div class="flex items-center justify-between gap-4 mb-1 text-[11px] text-orange-400/80 font-semibold">
                                    <span class="text-orange-400 flex items-center gap-1">
                                        <i class="fa-solid fa-wrench text-[10px]"></i> Usta (Siz)
                                    </span>
                                    <span><%= msg.created_at %></span>
                                </div>
                                <p class="leading-relaxed"><%= msg.message_text %></p>
                                <div class="text-[10px] text-emerald-400/90 font-medium mt-1.5 flex items-center justify-end gap-1">
                                    <i class="fa-brands fa-whatsapp"></i>
                                    <span>WhatsApp ile İletildi</span>
                                </div>
                            </div>
                            <div class="w-8 h-8 rounded-full bg-orange-600/20 text-orange-400 border border-orange-500/30 flex items-center justify-center flex-shrink-0 text-xs">
                                <i class="fa-solid fa-wrench"></i>
                            </div>
                        </div>
                    <% } %>
                <% }); %>
            <% } %>
        </div>

        <!-- Usta Cevap Yazma Formu -->
        <form action="/arac/<%= vehicle.id %>/mesaj-cevap" method="POST" class="space-y-3">
            <div class="relative">
                <textarea 
                    name="reply_text" 
                    rows="2" 
                    required 
                    placeholder="Müşterinizin WhatsApp'ına doğrudan yanıt yazın... (Örn: Parçanız geldi, saat 17:00'de aracınızı teslim alabilirsiniz.)" 
                    class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-2xl text-white text-sm focus:border-emerald-500 focus:outline-none placeholder:text-slate-500 resize-none"
                ></textarea>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <span class="text-[11px] text-slate-500 flex items-center gap-1">
                    <i class="fa-solid fa-shield-halved text-slate-400"></i>
                    Yazdığınız mesaj doğrudan müşterinin WhatsApp sohbetine iletilir.
                </span>
                <button 
                    type="submit" 
                    class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2 self-end sm:self-auto"
                >
                    <i class="fa-brands fa-whatsapp text-base"></i>
                    <span>Müşteriye WhatsApp'tan Yanıtla</span>
                </button>
            </div>
        </form>
    </div>

    <!-- SERVİS & HASARLI PARÇA FOTOĞRAFLARI (DİJİTAL EKSPERTİZ KANITI) -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-camera text-sky-400 text-xl"></i>
                    <span>Servis & Ekspertiz Fotoğrafları</span>
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">Hasarlı ve değişen parçaların fotoğraflı kanıtları (Müşteri ekranında ve WhatsApp'ta görünür)</p>
            </div>

            <button 
                type="button" 
                onclick="document.getElementById('upload-photo-modal').classList.remove('hidden')"
                class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow-lg shadow-sky-600/30 transition-all flex items-center gap-2 self-start sm:self-auto"
            >
                <i class="fa-solid fa-plus text-[10px]"></i>
                <span>Fotoğraf Yükle</span>
            </button>
        </div>

        <% if (!vehicle.photos || vehicle.photos.length === 0) { %>
            <div class="text-center py-10 px-4 rounded-2xl bg-slate-950/80 border border-slate-800/80 text-slate-400 text-sm">
                <i class="fa-regular fa-image text-3xl text-slate-600 mb-2 block"></i>
                Bu araca henüz parça/servis fotoğrafı eklenmemiş.<br>
                <span class="text-xs text-slate-500">Aşınmış veya değişen parçaların fotoğraflarını yükleyerek müşteriye şeffaf kanıt sunabilirsiniz.</span>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <% vehicle.photos.forEach(p => { %>
                    <div class="rounded-2xl bg-slate-950 border border-slate-800 overflow-hidden shadow-lg group hover:border-sky-500/50 transition-all">
                        <div class="relative overflow-hidden cursor-pointer" onclick="openPhotoPreview('<%= p.photo_path %>', '<%= p.caption || 'Servis Fotoğrafı' %>')">
                            <img 
                                src="<%= p.photo_path %>" 
                                alt="<%= p.caption || 'Servis Fotoğrafı' %>" 
                                class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                            >
                            <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
                                <span class="px-3 py-1.5 rounded-xl bg-slate-900/90 text-xs font-semibold flex items-center gap-1.5 border border-slate-700">
                                    <i class="fa-solid fa-magnifying-glass-plus"></i> Büyüt
                                </span>
                            </div>
                        </div>
                        <div class="p-4">
                            <div class="text-sm font-semibold text-white line-clamp-2">
                                <%= p.caption || 'Açıklama belirtilmedi' %>
                            </div>
                            <div class="text-[11px] text-slate-500 mt-2 flex items-center gap-1.5">
                                <i class="fa-regular fa-clock"></i>
                                <span><%= p.created_at %></span>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

</div>

<!-- YENİ PARÇA ONAY TALEBİ MODALI -->
<div id="new-approval-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 hidden">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="fa-brands fa-whatsapp text-emerald-500 text-xl"></i>
                <span>Parça Onayı Gönder</span>
            </h2>
            <button 
                type="button" 
                onclick="document.getElementById('new-approval-modal').classList.add('hidden')"
                class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center transition-colors"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="/arac/<%= vehicle.id %>/onay-talep" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Değişecek Parça Adı *</label>
                <input type="text" name="part_name" required placeholder="Örn: Arka Fren Balatası" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-orange-500 focus:outline-none">
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Fiyat / Usta Açıklaması</label>
                <textarea name="note" rows="3" placeholder="Örn: 1.200 TL (Mais Orijinal) - Balata aşınmış, fren mesafesi uzuyor" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-orange-500 focus:outline-none"></textarea>
            </div>

            <div class="p-3 rounded-xl bg-orange-500/10 border border-orange-500/20 text-xs text-orange-300 flex items-start gap-2.5">
                <i class="fa-solid fa-circle-info text-orange-400 mt-0.5"></i>
                <span>Bu talep anında <strong><%= vehicle.customer_phone %></strong> numaralı müşterinin WhatsApp hattına onay mesajı olarak iletilecektir.</span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                <button 
                    type="button" 
                    onclick="document.getElementById('new-approval-modal').classList.add('hidden')"
                    class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm transition-colors"
                >
                    Vazgeç
                </button>
                <button 
                    type="submit" 
                    class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-lg shadow-emerald-600/30 transition-all flex items-center gap-2"
                >
                    <i class="fa-brands fa-whatsapp text-base"></i>
                    <span>WhatsApp'a Gönder</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- FOTOĞRAF YÜKLEME MODALI -->
<div id="upload-photo-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 hidden">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-camera text-sky-400 text-xl"></i>
                <span>Fotoğraf & Kanıt Yükle</span>
            </h2>
            <button 
                type="button" 
                onclick="document.getElementById('upload-photo-modal').classList.add('hidden')"
                class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center transition-colors"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="/arac/<%= vehicle.id %>/foto-yukle" method="POST" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Fotoğraf Seç * (JPG, PNG, WEBP)</label>
                <input 
                    type="file" 
                    name="photo" 
                    required 
                    accept="image/*" 
                    class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-sky-500 focus:outline-none file:mr-4 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-sky-600 file:text-white hover:file:bg-sky-500 file:cursor-pointer"
                >
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Fotoğraf Açıklaması</label>
                <textarea 
                    name="caption" 
                    rows="3" 
                    placeholder="Örn: Sol ön salıncak burcunda aşınma ve çatlak tespit edildi" 
                    class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-sky-500 focus:outline-none placeholder:text-slate-500"
                ></textarea>
            </div>

            <!-- WhatsApp Gönderim Onayı -->
            <label class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-950 border border-slate-800/90 cursor-pointer select-none">
                <input type="checkbox" name="send_whatsapp" value="on" checked class="mt-1 w-4 h-4 rounded border-slate-700 bg-slate-900 text-emerald-500 focus:ring-emerald-500">
                <div class="text-xs">
                    <span class="font-bold text-white flex items-center gap-1.5">
                        <i class="fa-brands fa-whatsapp text-emerald-400"></i> Müşteriye WhatsApp'tan Görsel Olarak Gönder
                    </span>
                    <span class="text-slate-400 block mt-0.5">İşaretliyse fotoğraf anında müşterinin telefonuna kanıt olarak iletilir.</span>
                </div>
            </label>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                <button 
                    type="button" 
                    onclick="document.getElementById('upload-photo-modal').classList.add('hidden')"
                    class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm transition-colors"
                >
                    Vazgeç
                </button>
                <button 
                    type="submit" 
                    class="px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold text-sm shadow-lg shadow-sky-600/30 transition-all flex items-center gap-2"
                >
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    <span>Fotoğrafı Yükle</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- FOTOĞRAF BÜYÜTME (LIGHTBOX) MODALI -->
<div id="photo-preview-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/90 backdrop-blur-md p-4 hidden" onclick="closePhotoPreview()">
    <div class="max-w-3xl w-full bg-slate-900 border border-slate-800 rounded-3xl p-4 sm:p-6 shadow-2xl relative" onclick="event.stopPropagation()">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
            <h3 id="preview-caption" class="text-sm font-bold text-white">Servis Fotoğrafı</h3>
            <button type="button" onclick="closePhotoPreview()" class="w-8 h-8 rounded-lg bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="flex items-center justify-center bg-slate-950 rounded-2xl overflow-hidden max-h-[70vh]">
            <img id="preview-image" src="" alt="Önizleme" class="max-w-full max-h-[70vh] object-contain rounded-2xl">
        </div>
    </div>
</div>

<!-- Aşama Değiştirme Onay Scripti (SweetAlert2) -->
<script>
    async function confirmStageChange(newStage, confirmText) {
        const result = await window.confirmModal('Aşama Güncellemesi', confirmText, 'Evet, İlerlet');
        if (result && result.isConfirmed) {
            document.getElementById('stage-input').value = newStage;
            document.getElementById('stage-form').submit();
        }
    }

    function openPhotoPreview(src, caption) {
        document.getElementById('preview-image').src = src;
        document.getElementById('preview-caption').textContent = caption || 'Servis Fotoğrafı';
        document.getElementById('photo-preview-modal').classList.remove('hidden');
    }
    function closePhotoPreview() {
        document.getElementById('photo-preview-modal').classList.add('hidden');
    }

    // URL Toast Parametre Kontrolü
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('sent') === '1') {
        window.toast && window.toast('Onay talebi müşterinin WhatsApp hattına iletildi!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('stageUpdated') === '1') {
        window.toast && window.toast('Araç aşaması güncellendi ve müşteriye WhatsApp bildirimi iletildi!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('photoUploaded') === '1') {
        window.toast && window.toast('Fotoğraf başarıyla yüklendi ve müşteriye iletildi!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('replied') === '1') {
        window.toast && window.toast('Cevabınız müşterinin WhatsApp hattına iletildi!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('error')) {
        window.toast && window.toast(urlParams.get('error'), 'error');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
</script>
