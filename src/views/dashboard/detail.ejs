<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Geri Dön ve Başlık Barı -->
    <div class="flex items-center justify-between gap-4 mb-6">
        <a href="/dashboard" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-400 hover:text-white transition-colors">
            <i class="fa-solid fa-arrow-left text-xs"></i>
            <span>Liftlere Geri Dön</span>
        </a>

        <!-- Türk Plakası Tasarımı -->
        <div class="inline-flex items-center bg-white text-black font-mono font-black px-3 py-1 rounded-md border-2 border-slate-700 tracking-wider text-base shadow">
            <span class="bg-blue-700 text-white text-[10px] px-1.5 py-0.5 rounded -ml-2.5 mr-2 font-sans font-bold">TR</span>
            <%= vehicle.plate %>
        </div>
    </div>

    <!-- Üst Araç Bilgi Kartı -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl mb-8 relative overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div>
                <span class="px-3 py-1 rounded-lg bg-orange-500/10 text-orange-400 text-xs font-bold border border-orange-500/20">
                    <i class="fa-solid fa-arrow-up-from-bracket mr-1"></i> <%= vehicle.station || 'Lift 1' %>
                </span>
                <h1 class="text-2xl sm:text-3xl font-black text-white mt-3"><%= vehicle.car_model %></h1>
                <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400 mt-2">
                    <span><i class="fa-solid fa-user text-slate-500 mr-1.5"></i><%= vehicle.customer_name || 'Müşteri Belirtilmedi' %></span>
                    <span>•</span>
                    <span><i class="fa-brands fa-whatsapp text-emerald-500 mr-1.5"></i><%= vehicle.customer_phone %></span>
                    <% if (vehicle.mileage) { %>
                        <span>•</span>
                        <span><i class="fa-solid fa-gauge-high text-slate-500 mr-1.5"></i><%= vehicle.mileage.toLocaleString('tr-TR') %> KM</span>
                    <% } %>
                </div>
            </div>

            <!-- Tahmini Teslimat -->
            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 self-start md:self-auto text-right">
                <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Hedef Teslimat</div>
                <div class="text-base font-bold text-white mt-1">
                    <%= vehicle.estimated_delivery || 'Belirlenmedi' %>
                </div>
            </div>
        </div>

        <!-- Müşteri Şikayeti Kutusu -->
        <% if (vehicle.initial_complaint) { %>
            <div class="mt-6 p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 text-sm text-slate-300">
                <span class="font-bold text-orange-400">Müşteri Şikayeti:</span> <%= vehicle.initial_complaint %>
            </div>
        <% } %>
    </div>

    <!-- 6+1 AŞAMALI DURUM İLERLETİCİ (STEPPER) -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-list-check text-orange-500"></i>
                <span>Tamir Süreci ve Aşama Yönetimi</span>
            </h2>
            <div class="text-xs text-slate-400">
                Mevcut Durum: 
                <span class="font-bold text-orange-400 uppercase">
                    <%= vehicle.status === 'WAITING_PARTS' ? 'Parça Bekleniyor' : (vehicle.status === 'TESTING' ? 'Test Ediliyor' : (vehicle.status === 'INSPECTING' ? 'Teşhiste' : (vehicle.status === 'REPAIRING' ? 'Onarımda' : (vehicle.status === 'READY' ? 'Teslime Hazır' : (vehicle.status === 'DELIVERED' ? 'Teslim Edildi' : 'Kabul Edildi'))))) %>
                </span>
            </div>
        </div>

        <!-- Aşamaların Görsel Akışı -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 mb-8">
            <% 
                const stages = [
                    { key: 'RECEIVED', label: '1. Kabul Edildi', icon: 'fa-clipboard-check' },
                    { key: 'INSPECTING', label: '2. Teşhiste', icon: 'fa-magnifying-glass' },
                    { key: 'WAITING_PARTS', label: '3. Parça Bekliyor', icon: 'fa-boxes-packing' },
                    { key: 'REPAIRING', label: '4. Onarımda', icon: 'fa-wrench' },
                    { key: 'TESTING', label: '5. Testte', icon: 'fa-road' },
                    { key: 'READY', label: '6. Teslime Hazır', icon: 'fa-circle-check' }
                ];
                const stageOrder = ['RECEIVED', 'INSPECTING', 'WAITING_PARTS', 'REPAIRING', 'TESTING', 'READY', 'DELIVERED'];
                const currentIndex = stageOrder.indexOf(vehicle.status);
            %>

            <% stages.forEach((s, idx) => { 
                const isPassed = currentIndex >= idx;
                const isCurrent = vehicle.status === s.key;
            %>
                <div class="p-3.5 rounded-2xl border text-center transition-all <%= isCurrent ? 'bg-orange-600/10 border-orange-500 text-orange-400 ring-2 ring-orange-500/20' : (isPassed ? 'bg-slate-950 border-emerald-500/30 text-emerald-400' : 'bg-slate-950/50 border-slate-800 text-slate-500') %>">
                    <i class="fa-solid <%= s.icon %> text-lg mb-1.5"></i>
                    <div class="text-xs font-bold leading-tight"><%= s.label %></div>
                    <div class="text-[9px] mt-1 font-semibold uppercase tracking-wider">
                        <%= isCurrent ? 'ŞU ANKİ AŞAMA' : (isPassed ? 'TAMAMLANDI' : 'BEKLİYOR') %>
                    </div>
                </div>
            <% }); %>
        </div>

        <!-- Aşama Değiştirme Butonları & Hızlı Geri Alma / Seçim -->
        <form id="stage-form" action="/arac/<%= vehicle.id %>/stage" method="POST" class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-slate-800">
            <input type="hidden" name="status" id="stage-input">

            <!-- Bağlama Göre Akıllı İlerleme Butonları -->
            <div class="flex flex-wrap items-center gap-2.5">
                <% if (vehicle.status === 'RECEIVED') { %>
                    <button type="button" onclick="confirmStageChange('INSPECTING', 'Aracı arıza teşhis ve ekspertiz aşamasına almak istiyor musunuz?')" class="px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm transition-all flex items-center gap-2 shadow-lg shadow-purple-600/20">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>Teşhise Al</span>
                    </button>
                <% } else if (vehicle.status === 'INSPECTING') { %>
                    <button type="button" onclick="confirmStageChange('WAITING_PARTS', 'Parça siparişi verildi mi? Müşterinize parça beklendiği bilgisi iletilecektir.')" class="px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-semibold text-sm transition-all flex items-center gap-2 shadow-lg shadow-amber-600/20">
                        <i class="fa-solid fa-boxes-packing"></i>
                        <span>📦 Parça Bekleniyor</span>
                    </button>
                    <button type="button" onclick="confirmStageChange('REPAIRING', 'Parça gerekmiyorsa veya mevcutsa onarıma başlansın mı?')" class="px-4 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-semibold text-sm transition-all flex items-center gap-2 shadow-lg shadow-orange-600/20">
                        <i class="fa-solid fa-wrench"></i>
                        <span>🔧 Doğrudan Onarıma Başla</span>
                    </button>
                <% } else if (vehicle.status === 'WAITING_PARTS') { %>
                    <button type="button" onclick="confirmStageChange('REPAIRING', 'Sipariş edilen parçalar servise ulaştı mı? Montaja başlanacaktır.')" class="px-5 py-2.5 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-semibold text-sm transition-all flex items-center gap-2 shadow-lg shadow-orange-600/20">
                        <i class="fa-solid fa-wrench"></i>
                        <span>🔧 Parçalar Geldi, Onarıma Başla</span>
                    </button>
                <% } else if (vehicle.status === 'REPAIRING') { %>
                    <button type="button" onclick="confirmStageChange('TESTING', 'Onarım bitti mi? Araç yol ve kalite testine alınacaktır.')" class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all flex items-center gap-2 shadow-lg shadow-indigo-600/20">
                        <i class="fa-solid fa-road"></i>
                        <span>🚗 Yol Testine Al</span>
                    </button>
                    <button type="button" onclick="confirmStageChange('READY', 'Test gerekmiyorsa araç teslime hazır edilsin mi?')" class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-all flex items-center gap-2 shadow-lg shadow-emerald-600/20">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>✓ Teslimata Hazır Yap</span>
                    </button>
                <% } else if (vehicle.status === 'TESTING') { %>
                    <button type="button" onclick="confirmStageChange('READY', 'Yol testi başarıyla tamamlandı mı? Müşterinize teslime hazır WhatsApp bildirimi gönderilecektir.')" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-all flex items-center gap-2 shadow-lg shadow-emerald-600/20">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>✓ Test Başarılı, Teslime Hazır</span>
                    </button>
                    <button type="button" onclick="confirmStageChange('REPAIRING', 'Testte yeni bir arıza görüldüyse araç tekrar onarıma alınsın mı?')" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 font-semibold text-sm transition-all flex items-center gap-2 border border-slate-700">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>Tekrar Onarıma Al</span>
                    </button>
                <% } else if (vehicle.status === 'READY') { %>
                    <button type="button" onclick="confirmStageChange('DELIVERED', 'Araç müşteriye teslim edildi mi?')" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-all flex items-center gap-2 shadow-lg shadow-blue-600/20">
                        <i class="fa-solid fa-key"></i>
                        <span>🤝 Müşteriye Teslim Et</span>
                    </button>
                <% } else if (vehicle.status === 'DELIVERED') { %>
                    <div class="px-4 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold flex items-center gap-2">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Araç Müşteriye Teslim Edildi</span>
                    </div>
                <% } %>
            </div>

            <!-- Sağ Taraf: Serbest Aşama Seçici (Geri Alma) -->
            <div class="flex items-center gap-3 ml-auto">
                <select 
                    id="manual-stage-select"
                    onchange="if(this.value) { confirmStageChange(this.value, 'Aşamayı doğrudan ' + this.options[this.selectedIndex].text + ' durumuna çekmek istiyor musunuz?'); this.value = ''; }" 
                    class="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs font-semibold text-slate-300 hover:text-white focus:outline-none focus:border-slate-600 cursor-pointer"
                >
                    <option value="">⚙️ Manuel Aşama Seç (Geri Al / Değiştir)...</option>
                    <option value="RECEIVED">1. Kabul Edildi</option>
                    <option value="INSPECTING">2. Teşhiste</option>
                    <option value="WAITING_PARTS">3. Parça Bekleniyor</option>
                    <option value="REPAIRING">4. Onarımda</option>
                    <option value="TESTING">5. Test Ediliyor</option>
                    <option value="READY">6. Teslime Hazır</option>
                    <option value="DELIVERED">7. Teslim Edildi</option>
                </select>
            </div>
        </form>
    </div>

    <!-- WHATSAPP DİJİTAL PARÇA ONAY MASASI -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-brands fa-whatsapp text-emerald-500 text-xl"></i>
                    <span>WhatsApp Parça ve Fiyat Onayları</span>
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">Müşterinin telefonundan anlık tetiklenir</p>
            </div>

            <button 
                type="button" 
                onclick="document.getElementById('new-approval-modal').classList.remove('hidden')"
                class="px-4 py-2 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-bold text-xs shadow-lg shadow-orange-600/30 transition-all flex items-center gap-2 self-start sm:self-auto"
            >
                <i class="fa-solid fa-plus text-[10px]"></i>
                <span>Yeni Parça Onay Talebi Gönder</span>
            </button>
        </div>

        <% if (!vehicle.approvals || vehicle.approvals.length === 0) { %>
            <div class="text-center py-8 px-4 rounded-2xl bg-slate-950 border border-slate-800/80 text-slate-400 text-sm">
                Bu araç için henüz parça onay talebi gönderilmemiş.
            </div>
        <% } else { %>
            <div class="space-y-4">
                <% vehicle.approvals.forEach(appr => { %>
                    <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div>
                            <div class="flex items-center gap-2.5 flex-wrap">
                                <span class="text-base font-bold text-white"><%= appr.part_name %></span>
                                <% if (appr.price && appr.price > 0) { %>
                                    <span class="px-2.5 py-0.5 rounded-lg bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-bold font-mono">
                                        <%= Number(appr.price).toLocaleString('tr-TR') %> TL
                                    </span>
                                <% } %>
                            </div>
                            <div class="text-sm text-slate-400 mt-1"><%= appr.note || 'Açıklama belirtilmedi' %></div>
                            <div class="text-xs text-slate-500 mt-2">
                                <i class="fa-regular fa-clock mr-1"></i>Talep Zamanı: <%= appr.requested_at %>
                            </div>
                        </div>

                        <!-- Onay Rozeti -->
                        <div>
                            <% if (appr.status === 'APPROVED') { %>
                                <div class="px-4 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-bold text-sm flex items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-emerald-500"></i>
                                    <span>MÜŞTERİ ONAYLADI</span>
                                </div>
                            <% } else if (appr.status === 'PENDING') { %>
                                <div class="px-4 py-2 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 font-bold text-sm flex items-center gap-2 animate-pulse">
                                    <i class="fa-regular fa-clock text-amber-500"></i>
                                    <span>ONAY BEKLENİYOR (WhatsApp)</span>
                                </div>
                            <% } else { %>
                                <div class="px-4 py-2 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 font-bold text-sm flex items-center gap-2">
                                    <i class="fa-solid fa-circle-xmark text-rose-500"></i>
                                    <span>MÜŞTERİ REDDETTİ</span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <!-- DİJİTAL SERVİS FİŞİ & HESAP ÖZETİ (FATURA VE MASRAF DÖKÜMÜ) -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-file-invoice-dollar text-emerald-400 text-xl"></i>
                    <span>Dijital Servis Fişi & Hesap Özeti</span>
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">Onaylanan parçalar ve işçilik bedeli hesap özeti olarak müşterinin WhatsApp hattına iletilir</p>
            </div>

            <button 
                type="button" 
                onclick="openReceiptModal()"
                class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 transition-all flex items-center gap-2 self-start sm:self-auto"
            >
                <i class="fa-solid fa-receipt text-sm"></i>
                <span><%= vehicle.receipt ? 'Fişi Düzenle / Tekrar Gönder' : 'Servis Fişi Oluştur & Gönder' %></span>
            </button>
        </div>

        <% if (!vehicle.receipt) { %>
            <div class="text-center py-10 px-4 rounded-2xl bg-slate-950/80 border border-slate-800/80 text-slate-400 text-sm">
                <i class="fa-solid fa-file-invoice text-3xl text-slate-600 mb-2 block"></i>
                Bu araç için henüz servis fişi oluşturulmamış.<br>
                <span class="text-xs text-slate-500">Müşterinin onayladığı parçaları ve ustanın işçilik ücretini tek tıkla kurumsal bir döküm halinde kaydedebilir ve müşteriye iletebilirsiniz.</span>
            </div>
        <% } else { %>
            <!-- POS Tarzı Şık Fatura Görünümü -->
            <div class="rounded-2xl bg-slate-950 border border-slate-800 p-5 sm:p-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-800/80 gap-3 mb-4">
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-lg border border-emerald-500/20">
                            ✓ Düzenlendi & Kayıtlı
                        </span>
                        <div class="text-xs text-slate-500 mt-2">
                            <i class="fa-regular fa-clock mr-1"></i>Son Düzenleme: <%= vehicle.receipt.created_at %>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-[11px] font-medium text-slate-400">Genel Toplam Tutar</div>
                        <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono">
                            <%= Number(vehicle.receipt.total_amount).toLocaleString('tr-TR') %> TL
                        </div>
                    </div>
                </div>

                <!-- Kalem Tablosu -->
                <div class="space-y-2 mb-4">
                    <div class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Hizmet ve Parça Kalemleri</div>
                    <% if (vehicle.receipt.items && vehicle.receipt.items.length > 0) { %>
                        <% vehicle.receipt.items.forEach(it => { %>
                            <div class="flex items-center justify-between py-2 px-3 rounded-xl bg-slate-900/60 border border-slate-800/60 text-sm">
                                <span class="text-slate-200"><i class="fa-solid fa-wrench text-orange-400 text-xs mr-2"></i><%= it.name %></span>
                                <span class="font-mono font-bold text-white"><%= Number(it.price).toLocaleString('tr-TR') %> TL</span>
                            </div>
                        <% }); %>
                    <% } %>
                    
                    <% if (vehicle.receipt.labor_cost > 0) { %>
                        <div class="flex items-center justify-between py-2 px-3 rounded-xl bg-slate-900/60 border border-slate-800/60 text-sm">
                            <span class="text-slate-200"><i class="fa-solid fa-user-gear text-cyan-400 text-xs mr-2"></i>Periyodik Bakım & Usta İşçiliği</span>
                            <span class="font-mono font-bold text-white"><%= Number(vehicle.receipt.labor_cost).toLocaleString('tr-TR') %> TL</span>
                        </div>
                    <% } %>
                </div>

                <% if (vehicle.receipt.notes) { %>
                    <div class="p-3 rounded-xl bg-slate-900/50 border border-slate-800 text-xs text-slate-300">
                        <strong class="text-slate-400">Usta Garanti/Servis Notu:</strong> <%= vehicle.receipt.notes %>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- MÜŞTERİ WHATSAPP SORU VE YANIT GEÇMİŞİ (CANLI SOHBET) -->
    <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-comments text-cyan-400 text-xl"></i>
                    <span>Müşteri WhatsApp Sohbeti & Soru-Cevap</span>
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">Müşterinin WhatsApp'tan yazdığı sorular ve ustanın verdiği doğrudan yanıtlar</p>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-400 bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800 self-start sm:self-auto">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>WhatsApp Hattı: <%= vehicle.customer_phone %></span>
            </div>
        </div>

        <!-- Sohbet Akışı (Mesaj Baloncukları) -->
        <div id="chat-messages-container" class="space-y-4 max-h-96 overflow-y-auto pr-2 mb-6 p-4 rounded-2xl bg-slate-950/80 border border-slate-800/80">
            <% if (!vehicle.messages || vehicle.messages.length === 0) { %>
                <div id="no-messages-placeholder" class="text-center py-10 px-4 text-slate-400 text-sm">
                    <i class="fa-regular fa-comment-dots text-3xl text-slate-600 mb-2 block"></i>
                    Bu araç için henüz müşteri mesajı bulunmuyor.<br>
                    <span class="text-xs text-slate-500">Müşteri WhatsApp'tan soru yazdığında anında burada belirecektir.</span>
                </div>
            <% } else { %>
                <% vehicle.messages.forEach(msg => { %>
                    <% if (msg.sender_type === 'CUSTOMER') { %>
                        <!-- Müşteri Mesajı (Solda, Koyu Gri Balon) -->
                        <div class="flex items-start gap-3 max-w-xl">
                            <div class="w-8 h-8 rounded-full bg-slate-800 text-slate-300 flex items-center justify-center flex-shrink-0 text-xs border border-slate-700">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div class="bg-slate-800/90 border border-slate-700/60 rounded-2xl rounded-tl-sm p-4 text-sm text-slate-200 shadow-md">
                                <div class="flex items-center justify-between gap-4 mb-1 text-[11px] text-slate-400 font-semibold">
                                    <span class="text-emerald-400"><%= vehicle.customer_name %> (Müşteri)</span>
                                    <span><%= msg.created_at %></span>
                                </div>
                                <p class="leading-relaxed"><%= msg.message_text %></p>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Usta Yanıtı (Sağda, Turuncu Vurgulu Balon) -->
                        <div class="flex items-start justify-end gap-3 max-w-xl ml-auto">
                            <div class="bg-orange-950/40 border border-orange-500/30 rounded-2xl rounded-tr-sm p-4 text-sm text-orange-100 shadow-md">
