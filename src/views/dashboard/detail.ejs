<!-- Aşama Değiştirme Onay Scripti (SweetAlert2) -->
<script>
    async function confirmStageChange(newStage, confirmText) {
        const result = await window.confirmModal('Aşama Güncellemesi', confirmText, 'Evet, İlerlet');
        if (result && result.isConfirmed) {
            document.getElementById('stage-input').value = newStage;
            document.getElementById('stage-form').submit();
        }
    }

    function openPhotoPreview(src, caption) {
        document.getElementById('preview-image').src = src;
        document.getElementById('preview-caption').textContent = caption || 'Servis Fotoğrafı';
        document.getElementById('photo-preview-modal').classList.remove('hidden');
    }
    function closePhotoPreview() {
        document.getElementById('photo-preview-modal').classList.add('hidden');
    }

    // Fiş Modal ve Kalem Yönetimi
    const initialReceiptItems = <%- JSON.stringify(
        (vehicle.receipt && vehicle.receipt.items && vehicle.receipt.items.length > 0)
        ? vehicle.receipt.items
        : (vehicle.approvals ? vehicle.approvals.filter(a => a.status === 'APPROVED').map(a => {
            let p = (a.price && a.price > 0) ? a.price : 0;
            if (p === 0 && a.note) {
                const match = a.note.match(/(\d{1,3}(?:\.\d{3})*(?:,\d+)?|\d+)\s*(?:TL|tl)/);
                if (match) {
                    p = parseFloat(match[1].replace(/\./g, '').replace(',', '.')) || 0;
                }
            }
            return { name: a.part_name, price: p };
        }) : [])
    ) %>;

    function openReceiptModal() {
        const container = document.getElementById('receipt-items-container');
        if (container.children.length === 0) {
            if (initialReceiptItems.length > 0) {
                initialReceiptItems.forEach(item => addReceiptItem(item.name, item.price));
            } else {
                addReceiptItem('', '');
            }
        }
        calculateReceiptTotal();
        document.getElementById('service-receipt-modal').classList.remove('hidden');
    }

    function closeReceiptModal() {
        document.getElementById('service-receipt-modal').classList.add('hidden');
    }

    function addReceiptItem(name = '', price = '') {
        const container = document.getElementById('receipt-items-container');
        const row = document.createElement('div');
        row.className = 'flex items-center gap-2 receipt-item-row';
        row.innerHTML = `
            <input 
                type="text" 
                name="item_name" 
                placeholder="Parça / İşlem Adı (Örn: Motor Yağı)" 
                value="${name ? String(name).replace(/"/g, '&quot;') : ''}"
                required
                class="flex-1 px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-xs focus:border-emerald-500 focus:outline-none"
            >
            <div class="relative w-28">
                <input 
                    type="number" 
                    name="item_price" 
                    min="0"
                    step="any"
                    placeholder="Fiyat" 
                    value="${price}"
                    oninput="calculateReceiptTotal()"
                    class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-xs focus:border-emerald-500 focus:outline-none text-right pr-7 receipt-price-input"
                >
                <span class="absolute right-2 top-2 text-[11px] text-slate-500 font-bold">TL</span>
            </div>
            <button 
                type="button" 
                onclick="removeReceiptItem(this)" 
                class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 flex items-center justify-center transition-colors shrink-0"
            >
                <i class="fa-solid fa-trash-can text-xs"></i>
            </button>
        `;
        container.appendChild(row);
        calculateReceiptTotal();
    }

    function removeReceiptItem(btn) {
        const row = btn.closest('.receipt-item-row');
        if (row) {
            row.remove();
            calculateReceiptTotal();
        }
    }

    function calculateReceiptTotal() {
        let total = 0;
        const priceInputs = document.querySelectorAll('.receipt-price-input');
        priceInputs.forEach(input => {
            const val = parseFloat(input.value);
            if (!isNaN(val)) total += val;
        });
        const laborInput = document.getElementById('receipt-labor-cost');
        if (laborInput) {
            const laborVal = parseFloat(laborInput.value);
            if (!isNaN(laborVal)) total += laborVal;
        }
        const display = document.getElementById('receipt-total-display');
        if (display) {
            display.textContent = total.toLocaleString('tr-TR') + ' TL';
        }
    }

    // URL Toast Parametre Kontrolü
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('sent') === '1') {
        window.toast && window.toast('Onay talebi müşterinin WhatsApp hattına iletildi!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('stageUpdated') === '1') {
        window.toast && window.toast('Araç aşaması güncellendi ve müşteriye WhatsApp bildirimi iletildi!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('photoUploaded') === '1') {
        window.toast && window.toast('Fotoğraf başarıyla yüklendi ve müşteriye iletildi!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('replied') === '1') {
        window.toast && window.toast('Cevabınız müşterinin WhatsApp hattına iletildi!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('receiptSaved') === '1') {
        window.toast && window.toast('Servis fişi ve hesap özeti başarıyla kaydedildi!', 'success');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (urlParams.get('error')) {
        window.toast && window.toast(urlParams.get('error'), 'error');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
</script>
