<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Üst Başlık ve Geri Dönüş -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <a href="/dashboard" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-400 hover:text-white transition-colors">
                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                    <span>Liftlere Dön</span>
                </a>
                <span class="text-slate-700">•</span>
                <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">Tamamlanan İşler</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white flex items-center gap-3">
                <i class="fa-solid fa-box-archive text-amber-500"></i>
                <span>Servis Arşivi & Geçmiş Kayıtlar</span>
            </h1>
            <p class="text-sm text-slate-400 mt-1">İşlemleri tamamlanan ve teslim edilen araçların fatura, parça ve servis geçmişi</p>
        </div>

        <!-- Canlı İstatistikler -->
        <div class="flex items-center gap-3">
            <div class="px-4 py-2.5 rounded-2xl bg-slate-900 border border-slate-800 text-right">
                <div class="text-[10px] uppercase font-bold text-slate-400">Teslim Edilen Araç</div>
                <div id="total-delivered-count" class="text-lg font-black text-white"><%= totalDelivered %></div>
            </div>
            <div class="px-4 py-2.5 rounded-2xl bg-slate-900 border border-slate-800 text-right">
                <div class="text-[10px] uppercase font-bold text-slate-400">Arşiv Servis Hacmi</div>
                <div id="total-revenue-count" class="text-lg font-black text-emerald-400 font-mono"><%= totalRevenue.toLocaleString('tr-TR') %> TL</div>
            </div>
        </div>
    </div>

    <!-- AJAX Arama ve Filtreleme Barı -->
    <div class="rounded-2xl bg-slate-900 border border-slate-800 p-4 mb-8 shadow-xl">
        <div class="relative flex items-center">
            <i class="fa-solid fa-magnifying-glass absolute left-4 text-slate-500 text-sm"></i>
            <input 
                type="text" 
                id="archive-search-input"
                value="<%= searchQuery %>"
                placeholder="Plaka, müşteri adı, araç modeli veya telefon numarası ile anlık ara... (Örn: 34 BJK, Golf, Mehmet)"
                autocomplete="off"
                class="w-full pl-11 pr-24 py-3 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-amber-500 focus:outline-none placeholder:text-slate-500 transition-all"
            >
            <!-- Arama Yükleniyor Spinner'ı -->
            <div id="search-spinner" class="absolute right-12 text-amber-500 hidden animate-spin text-sm">
                <i class="fa-solid fa-circle-notch"></i>
            </div>
            <!-- Temizle Butonu -->
            <button 
                type="button" 
                id="clear-search-btn"
                onclick="clearArchiveSearch()"
                class="absolute right-3 px-2 py-1 rounded-lg text-slate-500 hover:text-slate-300 hover:bg-slate-800 text-xs font-semibold transition-all <%= searchQuery ? '' : 'hidden' %>"
            >
                Temizle
            </button>
        </div>
        <div class="flex items-center justify-between text-[11px] text-slate-500 mt-2 px-1">
            <span><i class="fa-solid fa-bolt text-amber-400 mr-1"></i>AJAX anlık arama etkindir, yazdıkça sonuçlar yenilenir.</span>
            <span id="results-count-text"><%= archivedCars.length %> kayıt listeleniyor</span>
        </div>
    </div>

    <!-- Arşiv Kartları Listesi -->
    <div id="archive-cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (archivedCars.length === 0) { %>
            <div class="col-span-full text-center py-16 px-4 rounded-3xl bg-slate-900/40 border border-slate-800/80">
                <div class="w-16 h-16 rounded-3xl bg-slate-800 flex items-center justify-center mx-auto mb-4 text-slate-500 text-2xl">
                    <i class="fa-solid fa-box-open"></i>
                </div>
                <h3 class="text-lg font-bold text-white">Arşivde araç kaydı bulunamadı</h3>
                <p class="text-sm text-slate-400 max-w-sm mx-auto mt-1">
                    <%= searchQuery ? 'Arama kriterlerinize uygun araç bulunamadı.' : 'Henüz müşteriye teslim edilmiş bir araç bulunmuyor.' %>
                </p>
            </div>
        <% } else { %>
            <% archivedCars.forEach(car => { %>
                <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 flex flex-col justify-between hover:border-amber-500/40 transition-all shadow-xl relative overflow-hidden group">
                    <div>
                        <!-- Üst Plaka ve Teslim Rozeti -->
                        <div class="flex items-center justify-between gap-2 mb-4">
                            <!-- TR Plaka Grafiği -->
                            <div class="inline-flex items-center bg-white text-black font-mono font-black px-2.5 py-1 rounded-md border-2 border-slate-700 tracking-wider text-sm shadow">
                                <span class="bg-blue-700 text-white text-[9px] px-1 py-0.5 rounded -ml-2 mr-1.5 font-sans font-bold">TR</span>
                                <%= car.plate %>
                            </div>

                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20 flex items-center gap-1">
                                <i class="fa-solid fa-circle-check text-[10px]"></i>
                                Teslim Edildi
                            </span>
                        </div>

                        <!-- Araç Modeli -->
                        <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                            <%= car.car_model %>
                        </h3>

                        <!-- Müşteri Bilgileri -->
                        <div class="text-xs text-slate-400 mt-2 space-y-1">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-user text-slate-500 w-3.5"></i>
                                <span class="text-slate-300 font-medium"><%= car.customer_name || 'Müşteri Belirtilmedi' %></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-phone text-slate-500 w-3.5"></i>
                                <span><%= car.customer_phone %></span>
                            </div>
                        </div>

                        <!-- Giriş & Teslim Tarihleri -->
                        <div class="mt-4 pt-3 border-t border-slate-800/80 grid grid-cols-2 gap-2 text-[11px]">
                            <div>
                                <span class="text-slate-500 block">Kabul Tarihi:</span>
                                <span class="text-slate-300 font-medium"><%= car.created_at ? car.created_at.substring(0, 16) : '-' %></span>
                            </div>
                            <div>
                                <span class="text-slate-500 block">Teslim Tarihi:</span>
                                <span class="text-emerald-400 font-medium"><%= car.completed_at ? car.completed_at.substring(0, 16) : '-' %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Alt Bar: Servis Bedeli & Detay Masasına Git -->
                    <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
                        <div>
                            <div class="text-[10px] text-slate-500 uppercase font-semibold">Servis Bedeli</div>
                            <% if (car.invoice_amount) { %>
                                <div class="text-base font-black text-emerald-400 font-mono">
                                    <%= Number(car.invoice_amount).toLocaleString('tr-TR') %> TL
                                </div>
                            <% } else { %>
                                <div class="text-xs text-slate-500">Fiş Kesilmedi</div>
                            <% } %>
                        </div>

                        <a 
                            href="/arac/<%= car.id %>" 
                            class="py-2 px-3.5 rounded-xl bg-slate-800 hover:bg-amber-600 text-slate-200 hover:text-white font-semibold text-xs transition-all flex items-center gap-1.5 shadow"
                        >
                            <i class="fa-solid fa-file-lines"></i>
                            <span>İncele</span>
                        </a>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>

</div>

<!-- AJAX Arama İstemci Scripti -->
<script>
    let searchDebounceTimer = null;
    const searchInput = document.getElementById('archive-search-input');
    const searchSpinner = document.getElementById('search-spinner');
    const clearBtn = document.getElementById('clear-search-btn');
    const cardsContainer = document.getElementById('archive-cards-container');
    const resultsCountText = document.getElementById('results-count-text');
    const deliveredCountEl = document.getElementById('total-delivered-count');
    const revenueCountEl = document.getElementById('total-revenue-count');

    searchInput.addEventListener('input', (e) => {
        const query = e.target.value;
        if (query.trim()) {
            clearBtn.classList.remove('hidden');
        } else {
            clearBtn.classList.add('hidden');
        }

        clearTimeout(searchDebounceTimer);
        searchSpinner.classList.remove('hidden');

        searchDebounceTimer = setTimeout(() => {
            fetchArchiveResults(query);
        }, 250); // 250ms akıcı debounce
    });

    async function fetchArchiveResults(query) {
        try {
            const url = `/arsiv?ajax=1&q=${encodeURIComponent(query)}`;
            const response = await fetch(url, {
                headers: { 'Accept': 'application/json' }
            });
            const data = await response.json();

            if (data && data.success) {
                renderArchiveCards(data.archivedCars, query);
                deliveredCountEl.textContent = data.totalDelivered;
                revenueCountEl.textContent = Number(data.totalRevenue).toLocaleString('tr-TR') + ' TL';
                resultsCountText.textContent = `${data.archivedCars.length} kayıt listeleniyor`;

                // URL'yi sayfayı yenilemeden temiz güncelle
                const newUrl = query ? `/arsiv?q=${encodeURIComponent(query)}` : '/arsiv';
                window.history.replaceState({}, '', newUrl);
            }
        } catch (err) {
            console.error('Arşiv AJAX arama hatası:', err);
        } finally {
            searchSpinner.classList.add('hidden');
        }
    }

    function clearArchiveSearch() {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        fetchArchiveResults('');
    }

    function renderArchiveCards(cars, query) {
        if (!cars || cars.length === 0) {
            cardsContainer.innerHTML = `
                <div class="col-span-full text-center py-16 px-4 rounded-3xl bg-slate-900/40 border border-slate-800/80">
                    <div class="w-16 h-16 rounded-3xl bg-slate-800 flex items-center justify-center mx-auto mb-4 text-slate-500 text-2xl">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white">Arşivde araç kaydı bulunamadı</h3>
                    <p class="text-sm text-slate-400 max-w-sm mx-auto mt-1">
                        ${query ? '<strong>"' + escapeHtml(query) + '"</strong> aramasına uygun araç bulunamadı.' : 'Henüz teslim edilmiş araç bulunmuyor.'}
                    </p>
                </div>
            `;
            return;
        }

        cardsContainer.innerHTML = cars.map(car => `
            <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 flex flex-col justify-between hover:border-amber-500/40 transition-all shadow-xl relative overflow-hidden group">
                <div>
                    <!-- Üst Plaka ve Teslim Rozeti -->
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <div class="inline-flex items-center bg-white text-black font-mono font-black px-2.5 py-1 rounded-md border-2 border-slate-700 tracking-wider text-sm shadow">
                            <span class="bg-blue-700 text-white text-[9px] px-1 py-0.5 rounded -ml-2 mr-1.5 font-sans font-bold">TR</span>
                            ${escapeHtml(car.plate)}
                        </div>
                        <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20 flex items-center gap-1">
                            <i class="fa-solid fa-circle-check text-[10px]"></i>
                            Teslim Edildi
                        </span>
                    </div>

                    <!-- Araç Modeli -->
                    <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">
                        ${escapeHtml(car.car_model)}
                    </h3>

                    <!-- Müşteri Bilgileri -->
                    <div class="text-xs text-slate-400 mt-2 space-y-1">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-user text-slate-500 w-3.5"></i>
                            <span class="text-slate-300 font-medium">${escapeHtml(car.customer_name || 'Müşteri Belirtilmedi')}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-phone text-slate-500 w-3.5"></i>
                            <span>${escapeHtml(car.customer_phone || '')}</span>
                        </div>
                    </div>

                    <!-- Giriş & Teslim Tarihleri -->
                    <div class="mt-4 pt-3 border-t border-slate-800/80 grid grid-cols-2 gap-2 text-[11px]">
                        <div>
                            <span class="text-slate-500 block">Kabul Tarihi:</span>
                            <span class="text-slate-300 font-medium">${car.created_at ? car.created_at.substring(0, 16) : '-'}</span>
                        </div>
                        <div>
                            <span class="text-slate-500 block">Teslim Tarihi:</span>
                            <span class="text-emerald-400 font-medium">${car.completed_at ? car.completed_at.substring(0, 16) : '-'}</span>
                        </div>
                    </div>
                </div>

                <!-- Alt Bar: Servis Bedeli & Detay Masasına Git -->
                <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
                    <div>
                        <div class="text-[10px] text-slate-500 uppercase font-semibold">Servis Bedeli</div>
                        ${car.invoice_amount ? `
                            <div class="text-base font-black text-emerald-400 font-mono">
                                ${Number(car.invoice_amount).toLocaleString('tr-TR')} TL
                            </div>
                        ` : `
                            <div class="text-xs text-slate-500">Fiş Kesilmedi</div>
                        `}
                    </div>

                    <a 
                        href="/arac/${car.id}" 
                        class="py-2 px-3.5 rounded-xl bg-slate-800 hover:bg-amber-600 text-slate-200 hover:text-white font-semibold text-xs transition-all flex items-center gap-1.5 shadow"
                    >
                        <i class="fa-solid fa-file-lines"></i>
                        <span>İncele</span>
                    </a>
                </div>
            </div>
        `).join('');
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
</script>
