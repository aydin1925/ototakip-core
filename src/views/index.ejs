<!-- ========================================================= -->
<!-- ARKA PLAN FOTOĞRAFI & SİNEMATİK TİTANYUM MONOKROM KATMAN   -->
<!-- ========================================================= -->
<div id="hero-bg-container" class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
    <!-- 1. Gerçek Atölye Fotoğrafı -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat scale-100"
         style="background-image: url('/images/workshop_hero.jpg');"></div>
    
    <!-- 2. Titanyum Monokrom Dengeli Karartma Katmanı -->
    <div class="absolute inset-0"
         style="background: rgba(8, 10, 15, 0.65);"></div>

    <!-- 3. Kenar Yumuşatma / İnce Vignette -->
    <div class="absolute inset-0"
         style="background: linear-gradient(180deg, rgba(8,10,15,0.50) 0%, transparent 20%, transparent 80%, rgba(8,10,15,0.85) 100%);"></div>
</div>

<!-- SOL ÜST KÖŞE ZARİF LOGO -->
<div class="absolute top-4 left-4 sm:top-6 sm:left-8 z-40">
    <a href="/" class="font-display font-bold text-lg sm:text-xl tracking-tight text-white flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-white text-xs backdrop-blur-md group-hover:bg-white/20 transition-all">
            <i class="fa-solid fa-car-side"></i>
        </div>
        <span class="tracking-normal font-serif">Oto<span class="text-slate-300 font-light">Takip</span></span>
    </a>
</div>

<!-- SAĞ ÜST KÖŞEDE ZARİF VE AYRIK USTA GİRİŞİ KAPSÜLÜ (AYDINLIK & KRİSTAL) -->
<div class="absolute top-4 right-4 sm:top-6 sm:right-8 z-40">
    <a href="/login" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/20 hover:bg-white/30 text-white text-xs font-bold border border-white/50 shadow-md backdrop-blur-md transition-all hover:border-white">
        <i class="fa-solid fa-wrench text-[11px] text-white"></i>
        <span>Usta Girişi</span>
    </a>
</div>

<!-- ANA İÇERİK (DİKEYDE TAM ORTALANMIŞ) -->
<main class="min-h-screen w-full max-w-6xl mx-auto px-4 sm:px-6 flex flex-col justify-center py-20 sm:py-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <!-- Sol Taraf: Kristal Netliğinde, Ciddi Kurumsal Tipografi -->
        <div class="space-y-6 text-left">
            <h1 class="text-4xl sm:text-5xl lg:text-[4.2rem] font-display font-normal tracking-tight text-white leading-[1.08]">
                Servisiniz konuşsun, <br> siz işinize odaklanın.
            </h1>
            
            <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal max-w-md pt-1">
                Araç kabulden WhatsApp onayına kadar her detay otomatik aksın; müşteriniz anbean bilgilensin.
            </p>
            
            <!-- AYDINLIK & YÜKSEK KONTRASTLI BUTONLAR -->
            <div class="pt-3 lg:pt-5 flex flex-wrap items-center gap-4">
                <a href="/register" class="px-8 py-3.5 rounded-xl bg-white hover:bg-slate-50 active:bg-slate-100 text-slate-950 font-bold text-sm shadow-[0_4px_24px_rgba(255,255,255,0.22)] border border-white transition-all flex items-center gap-2.5 hover:-translate-y-0.5">
                    <span>Hemen Servis Aç</span>
                    <i class="fa-solid fa-arrow-right text-xs text-slate-950"></i>
                </a>
                <a href="/login" class="px-7 py-3.5 rounded-xl bg-white/20 hover:bg-white/30 border border-white/60 text-white font-bold text-sm transition-all backdrop-blur-md shadow-[0_4px_16px_rgba(255,255,255,0.10)] flex items-center gap-2 hover:border-white hover:-translate-y-0.5">
                    <i class="fa-solid fa-lock text-xs text-white"></i>
                    <span>Usta Girişi</span>
                </a>
            </div>

            <!-- Canlı Müşteri Plaka Sorgulama Hızlı Alanı (Kristal Cam Tasarım) -->
            <div class="pt-2 max-w-md">
                <form action="/takip" method="GET" class="bg-white/10 hover:bg-white/15 backdrop-blur-md border border-white/20 hover:border-white/30 rounded-2xl p-2 flex items-center gap-2 shadow-lg transition-all">
                    <div class="pl-3 text-slate-300">
                        <i class="fa-solid fa-magnifying-glass text-xs"></i>
                    </div>
                    <input 
                        type="text" 
                        name="plaka" 
                        required 
                        placeholder="Müşteri Takip: Plaka Giriniz (Örn: 34 BCD 128)" 
                        class="flex-1 bg-transparent border-none text-xs sm:text-sm font-bold text-white placeholder-slate-400 focus:outline-none uppercase font-mono tracking-wider"
                    >
                    <button type="submit" class="bg-white hover:bg-slate-100 text-slate-950 text-xs font-bold px-4 py-2.5 rounded-xl transition-all shadow-md shrink-0 cursor-pointer">
                        Sorgula
                    </button>
                </form>
            </div>
        </div>

        <!-- Sağdaki Vitrin: Kristal İnce Cam Kart (İçeriği Her Zaman Inter) -->
        <div class="relative flex justify-center lg:justify-end">
            
            <div id="card-variant-station-dark" class="w-full max-w-sm rounded-3xl p-7 sm:py-9 sm:px-8 relative border shadow-2xl text-white space-y-5 sm:space-y-6 transition-all duration-300" style="background: rgba(255, 255, 255, 0.04); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); border-color: rgba(255, 255, 255, 0.20);">
                <!-- Üst İstasyon Durumu -->
                <div class="flex items-center justify-between pb-0.5">
                    <div class="flex items-center gap-2">
                        <span class="relative flex h-2.5 w-2.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
                        </span>
                        <span class="font-bold text-white text-xs tracking-wider uppercase">İstasyon 01 <span class="text-slate-300 font-normal normal-case">• Mekanik</span></span>
                    </div>
                    <span class="px-3 py-1 rounded-full text-[11px] font-semibold text-emerald-300 border border-emerald-400/35 bg-emerald-500/10">
                        Onarımda
                    </span>
                </div>

                <!-- Araç Başlığı & Plaka (Yan Yana, Ferah & Modern) -->
                <div class="flex items-center justify-between gap-3 pt-1">
                    <div>
                        <h3 class="font-bold text-white text-xl tracking-tight leading-tight">Dacia Sandero</h3>
                        <div class="text-xs text-slate-300 mt-1 flex items-center gap-1.5 font-light">
                            <span>Ahmet Yılmaz</span>
                            <span class="text-white/40">•</span>
                            <span class="text-slate-300">0532 555 01 23</span>
                        </div>
                    </div>
                    <div class="plate shrink-0 shadow-md">
                        <span class="plate-tr">TR</span>
                        <span class="plate-num">34 BCD 128</span>
                    </div>
                </div>

                <!-- Şikayet / Arıza (Kutusuz, Temiz Tipografi) -->
                <div class="flex items-center gap-2.5 text-xs text-slate-200 leading-relaxed py-0.5">
                    <i class="fa-solid fa-wrench text-slate-300 text-sm shrink-0"></i>
                    <span>Ön Sağ Amortisör & Yağ Kaçağı tespiti</span>
                </div>

                <!-- Canlı Servis İlerlemesi -->
                <div class="space-y-2 py-0.5">
                    <div class="flex items-center justify-between text-xs text-slate-300">
                        <span class="flex items-center gap-1.5 font-medium">
                            <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                            Parça Montajı Yapılıyor
                        </span>
                        <span class="font-mono text-white font-bold text-xs">%70</span>
                    </div>
                    <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
                        <div class="h-full bg-white rounded-full transition-all" style="width: 70%;"></div>
                    </div>
                </div>

                <!-- WhatsApp Onay Rozeti (Zarif İnce Cam Hap) -->
                <div class="py-3 px-4 rounded-2xl border flex items-center justify-between transition-all" style="background: rgba(74, 222, 128, 0.08); border-color: rgba(74, 222, 128, 0.35);">
                    <div class="flex items-center gap-2.5">
                        <i class="fa-brands fa-whatsapp text-xl text-[#25D366]"></i>
                        <div>
                            <div class="text-xs font-bold text-white">WhatsApp Onayı Alındı</div>
                            <div class="text-[10px] text-emerald-300 font-mono">14:22 • Teklif onaylandı</div>
                        </div>
                    </div>
                    <span class="text-sm font-mono font-extrabold text-emerald-400">2.700 ₺</span>
                </div>

                <!-- Aksiyon Butonu (Ghost Cam Buton) -->
                <div class="pt-1.5">
                    <a href="/login" class="w-full hover:bg-white/15 active:bg-white/20 text-white font-semibold text-xs sm:text-sm py-3 px-5 rounded-2xl border transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm group" style="background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.25);">
                        <span>İşlem Masasını Aç</span>
                        <i class="fa-solid fa-arrow-right text-xs text-slate-300 group-hover:text-white group-hover:translate-x-1 transition-all"></i>
                    </a>
                </div>
            </div>

        </div>

    </div>

</main>
