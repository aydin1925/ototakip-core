<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'SüperAdmin Konsolu — OtoTakip' %></title>
    
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Inter, Manrope, JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                        display: ['Manrope', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    boxShadow: {
                        'drawer': '-10px 0 30px -5px rgba(0, 0, 0, 0.4)',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #090b10;
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .superadmin-sidebar-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.55rem 0.75rem;
            border-radius: 0.75rem;
            font-size: 0.8125rem;
            font-weight: 500;
            color: #94a3b8;
            transition: all 0.15s ease;
            cursor: pointer;
        }
        .superadmin-sidebar-item:hover {
            color: #f8fafc;
            background-color: rgba(255, 255, 255, 0.05);
        }
        .superadmin-sidebar-item.active {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.1);
            font-weight: 700;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .superadmin-sidebar-item.active i {
            color: #38bdf8;
        }

        .admin-card {
            background: rgba(15, 23, 42, 0.45);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
        }

        .admin-input {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #f8fafc;
            transition: all 0.15s ease;
        }
        .admin-input:focus {
            outline: none;
            background: rgba(15, 23, 42, 0.85);
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
        }

        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
    </style>
</head>
<body class="min-h-screen flex overflow-x-hidden text-slate-100 bg-[#090b10]">

    <!-- ━━━━ MOBİL ÇEKMECE BACKDROP & SİDEBAR (Off-canvas) ━━━━ -->
    <div id="mobile-sidebar-backdrop" onclick="toggleMobileSidebar(false)" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-40 hidden transition-opacity duration-300 md:hidden"></div>

    <aside id="mobile-sidebar" class="fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-[#0c1017] border-r border-white/10 z-50 flex flex-col justify-between transform -translate-x-full transition-transform duration-300 ease-in-out md:hidden shadow-2xl">
        <!-- Üst Kısım: Logo ve Menüler -->
        <div class="p-5 space-y-6 overflow-y-auto">
            <!-- Logo & Kapat Butonu -->
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-500 to-blue-600 flex items-center justify-center text-white text-base shadow-lg shadow-sky-500/20">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div>
                        <h1 class="font-display font-extrabold text-base tracking-tight text-white leading-tight">Oto<span class="text-sky-400">Takip</span></h1>
                        <div class="flex items-center gap-1.5 mt-0.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span class="text-[10px] text-zinc-400 font-mono uppercase tracking-wider">SüperAdmin v2.4</span>
                        </div>
                    </div>
                </div>
                <button type="button" onclick="toggleMobileSidebar(false)" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 text-zinc-400 hover:text-white flex items-center justify-center transition border border-white/10 active:scale-95" aria-label="Menüyü Kapat">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <!-- Navigasyon: Platform Yönetimi -->
            <div class="space-y-1">
                <div class="px-2 text-[10px] font-bold font-mono uppercase tracking-wider text-zinc-500 mb-2">Platform Yönetimi</div>
                
                <button type="button" onclick="switchSuperadminTab('workshops')" id="admin-mob-nav-workshops" class="superadmin-sidebar-item active w-full">
                    <i class="fa-solid fa-warehouse text-xs text-sky-400"></i>
                    <span class="flex-1 text-left">Kayıtlı Servisler</span>
                    <span class="px-1.5 py-0.2 rounded font-mono text-[10px] bg-white/10 text-white"><%= totalServices %></span>
                </button>

                <button type="button" onclick="switchSuperadminTab('subscriptions')" id="admin-mob-nav-subscriptions" class="superadmin-sidebar-item w-full">
                    <i class="fa-solid fa-chart-pie text-xs text-zinc-400"></i>
                    <span class="flex-1 text-left">Kapasite &amp; Telemetri</span>
                    <span class="px-1.5 py-0.2 rounded font-mono text-[10px] text-emerald-400 bg-emerald-500/10 font-bold">Ücretsiz</span>
                </button>
            </div>

            <!-- Navigasyon: Servis Görünümü -->
            <div class="space-y-1">
                <div class="px-2 text-[10px] font-bold font-mono uppercase tracking-wider text-zinc-500 mb-2">Servis Görünümü</div>
                
                <button type="button" onclick="switchSuperadminTab('profile')" id="admin-mob-nav-profile" class="superadmin-sidebar-item w-full">
                    <i class="fa-solid fa-address-book text-xs text-zinc-400"></i>
                    <span class="flex-1 text-left">Oto Servis Profili</span>
                    <span class="px-1.5 py-0.2 rounded font-mono text-[10px] bg-sky-500/10 text-sky-400 font-bold">Rehber</span>
                </button>
            </div>

            <!-- Navigasyon: Altyapı & Sağlık -->
            <div class="space-y-1">
                <div class="px-2 text-[10px] font-bold font-mono uppercase tracking-wider text-zinc-500 mb-2">Altyapı &amp; Sağlık</div>
                
                <button type="button" onclick="switchSuperadminTab('system')" id="admin-mob-nav-system" class="superadmin-sidebar-item w-full">
                    <i class="fa-solid fa-server text-xs text-zinc-400"></i>
                    <span class="flex-1 text-left">WhatsApp &amp; Sistem</span>
                    <span class="w-2 h-2 rounded-full <%= isWhatsappConnected ? 'bg-emerald-400' : 'bg-amber-400' %>"></span>
                </button>

                <button type="button" onclick="switchSuperadminTab('logs')" id="admin-mob-nav-logs" class="superadmin-sidebar-item w-full">
                    <i class="fa-solid fa-clock-rotate-left text-xs text-zinc-400"></i>
                    <span class="flex-1 text-left">Denetim Günlüğü</span>
                </button>
            </div>

            <!-- Hızlı Aksiyon: Veritabanı Yedeği (Mobil Menüde) -->
            <div class="pt-2">
                <a href="/superadmin/backup" class="flex items-center gap-2 p-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-semibold text-zinc-300 hover:text-white transition">
                    <i class="fa-solid fa-download text-xs text-sky-400"></i>
                    <span>Veritabanı Yedeğini İndir</span>
                </a>
            </div>
        </div>

        <!-- Alt Kısım: WebP Depolama Metresi & Admin Bilgisi -->
        <div class="p-4 border-t border-white/10 space-y-3 bg-white/[0.02]">
            <% if (typeof mediaStats !== 'undefined' && mediaStats) { %>
                <div class="p-3 bg-white/5 rounded-xl border border-white/10 space-y-2 text-xs">
                    <div class="flex items-center justify-between text-[11px] font-semibold text-zinc-300">
                        <span class="flex items-center gap-1.5">
                            <i class="fa-solid fa-photo-film text-sky-400"></i>
                            WebP Medya
                        </span>
                        <span class="font-mono text-white font-bold"><%= mediaStats.formattedSize %></span>
                    </div>
                    <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
                        <div class="bg-sky-500 h-1.5 rounded-full" style="width: <%= Math.min(100, Math.max(8, Math.round((mediaStats.bytes / (50 * 1024 * 1024)) * 100))) %>%"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-zinc-500 font-mono">
                        <span>Sharp: -%71 Tasarruf</span>
                        <span><%= mediaStats.fileCount %> Görsel</span>
                    </div>
                </div>
            <% } %>

            <div class="flex items-center justify-between px-1">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-white/10 text-white font-bold text-xs flex items-center justify-center border border-white/10">
                        SA
                    </div>
                    <div>
                        <div class="text-xs font-bold text-white"><%= adminUser ? adminUser.username : 'Yönetici' %></div>
                        <div class="text-[10px] text-zinc-500 font-mono"><%= adminUser ? adminUser.email : 'root@ototakip.com' %></div>
                    </div>
                </div>
                <a href="/superadmin/logout" class="text-zinc-500 hover:text-rose-400 p-1.5 rounded-lg transition" title="Güvenli Çıkış">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- ━━━━ 1. SOL SABİT MASAÜSTÜ SİDEBAR ━━━━ -->
    <aside class="w-64 bg-white/[0.03] border-r border-white/10 flex-shrink-0 flex flex-col justify-between hidden md:flex sticky top-0 h-screen z-30">
        
        <!-- Üst Kısım: Logo ve Menüler -->
        <div class="p-5 space-y-6 overflow-y-auto">
            
            <!-- Logo & Marka -->
            <div class="flex items-center gap-3 px-1">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-500 to-blue-600 flex items-center justify-center text-white text-base shadow-lg shadow-sky-500/20">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h1 class="font-display font-extrabold text-base tracking-tight text-white leading-tight">Oto<span class="text-sky-400">Takip</span></h1>
                    <div class="flex items-center gap-1.5 mt-0.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span class="text-[10px] text-zinc-400 font-mono uppercase tracking-wider">SüperAdmin v2.4</span>
                    </div>
                </div>
            </div>

            <!-- Navigasyon: YÖNETİM -->
            <div class="space-y-1">
                <div class="px-2 text-[10px] font-bold font-mono uppercase tracking-wider text-zinc-500 mb-2">Platform Yönetimi</div>
                
                <button type="button" onclick="switchSuperadminTab('workshops')" id="admin-nav-workshops" class="superadmin-sidebar-item active w-full">
                    <i class="fa-solid fa-warehouse text-xs text-sky-400"></i>
                    <span class="flex-1 text-left">Kayıtlı Servisler</span>
                    <span class="px-1.5 py-0.2 rounded font-mono text-[10px] bg-white/10 text-white"><%= totalServices %></span>
                </button>

                <button type="button" onclick="switchSuperadminTab('subscriptions')" id="admin-nav-subscriptions" class="superadmin-sidebar-item w-full">
                    <i class="fa-solid fa-chart-pie text-xs text-zinc-400"></i>
                    <span class="flex-1 text-left">Kapasite &amp; Telemetri</span>
                    <span class="px-1.5 py-0.2 rounded font-mono text-[10px] text-emerald-400 bg-emerald-500/10 font-bold">Ücretsiz</span>
                </button>
            </div>

            <!-- Navigasyon: SERVİS PROFİLİ -->
            <div class="space-y-1">
                <div class="px-2 text-[10px] font-bold font-mono uppercase tracking-wider text-zinc-500 mb-2">Servis Görünümü</div>
                
                <button type="button" onclick="switchSuperadminTab('profile')" id="admin-nav-profile" class="superadmin-sidebar-item w-full">
                    <i class="fa-solid fa-address-book text-xs text-zinc-400"></i>
                    <span class="flex-1 text-left">Oto Servis Profili</span>
                    <span class="px-1.5 py-0.2 rounded font-mono text-[10px] bg-sky-500/10 text-sky-400 font-bold">Rehber</span>
                </button>
            </div>

            <!-- Navigasyon: ALTYAPI VE SAĞLIK -->
            <div class="space-y-1">
                <div class="px-2 text-[10px] font-bold font-mono uppercase tracking-wider text-zinc-500 mb-2">Altyapı &amp; Sağlık</div>
                
                <button type="button" onclick="switchSuperadminTab('system')" id="admin-nav-system" class="superadmin-sidebar-item w-full">
                    <i class="fa-solid fa-server text-xs text-zinc-400"></i>
                    <span class="flex-1 text-left">WhatsApp &amp; Sistem</span>
                    <span class="w-2 h-2 rounded-full <%= isWhatsappConnected ? 'bg-emerald-400' : 'bg-amber-400' %>"></span>
                </button>

                <button type="button" onclick="switchSuperadminTab('logs')" id="admin-nav-logs" class="superadmin-sidebar-item w-full">
                    <i class="fa-solid fa-clock-rotate-left text-xs text-zinc-400"></i>
                    <span class="flex-1 text-left">Denetim Günlüğü</span>
                </button>
            </div>

        </div>

        <!-- Alt Kısım: WebP Depolama Metresi & Admin Bilgisi -->
        <div class="p-4 border-t border-white/10 space-y-3 bg-white/[0.02]">
            
            <% if (typeof mediaStats !== 'undefined' && mediaStats) { %>
                <!-- WebP Medya Depolama Metresi -->
                <div class="p-3 bg-white/5 rounded-xl border border-white/10 space-y-2 text-xs">
                    <div class="flex items-center justify-between text-[11px] font-semibold text-zinc-300">
                        <span class="flex items-center gap-1.5">
                            <i class="fa-solid fa-photo-film text-sky-400"></i>
                            WebP Medya
                        </span>
                        <span class="font-mono text-white font-bold"><%= mediaStats.formattedSize %></span>
                    </div>
                    <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
                        <div class="bg-sky-500 h-1.5 rounded-full" style="width: <%= Math.min(100, Math.max(8, Math.round((mediaStats.bytes / (50 * 1024 * 1024)) * 100))) %>%"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-zinc-500 font-mono">
                        <span>Sharp: -%71 Tasarruf</span>
                        <span><%= mediaStats.fileCount %> Görsel</span>
                    </div>
                </div>
            <% } %>

            <div class="flex items-center justify-between px-1">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-white/10 text-white font-bold text-xs flex items-center justify-center border border-white/10">
                        SA
                    </div>
                    <div>
                        <div class="text-xs font-bold text-white"><%= adminUser ? adminUser.username : 'Yönetici' %></div>
                        <div class="text-[10px] text-zinc-500 font-mono"><%= adminUser ? adminUser.email : 'root@ototakip.com' %></div>
                    </div>
                </div>
                <a href="/superadmin/logout" class="text-zinc-500 hover:text-rose-400 p-1.5 rounded-lg transition" title="Güvenli Çıkış">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                </a>
            </div>
        </div>

    </aside>

    <!-- ━━━━ 2. SAĞ ANA ÇALIŞMA ALANI ━━━━ -->
    <div class="flex-1 flex flex-col min-w-0">
        
        <!-- Üst İnce Durum Çubuğu -->
        <header class="bg-white/[0.02] backdrop-blur-xl border-b border-white/10 px-4 sm:px-6 py-3 sm:py-3.5 flex items-center justify-between gap-3 sm:gap-4 sticky top-0 z-20">
            
            <!-- Sol: Hamburger + Ekmek Kırıntısı -->
            <div class="flex items-center gap-2.5 sm:gap-3 text-xs min-w-0">
                <button type="button" onclick="toggleMobileSidebar(true)" class="md:hidden w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 text-zinc-300 hover:text-white flex items-center justify-center transition border border-white/10 active:scale-95 shrink-0" aria-label="Menüyü Aç">
                    <i class="fa-solid fa-bars text-sm"></i>
                </button>
                <div class="flex items-center gap-1.5 sm:gap-2 truncate">
                    <span class="text-zinc-500 font-medium hidden sm:inline">SüperAdmin</span>
                    <span class="text-zinc-600 hidden sm:inline">/</span>
                    <span class="text-white font-bold truncate" id="current-superadmin-view-title">Kayıtlı Servisler</span>
                </div>
            </div>

            <!-- Sağ: Canlı Sistem Durumu & Aksiyonlar -->
            <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                <div class="hidden lg:flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-semibold text-emerald-400">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Tüm Servis Sistemleri Aktif</span>
                </div>
                
                <a href="/superadmin/backup" class="hidden sm:flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-semibold text-zinc-300 hover:text-white transition" title="Veritabanı Yedeği İndir">
                    <i class="fa-solid fa-download text-xs text-zinc-400"></i>
                    <span class="hidden md:inline">Veritabanı Yedeği</span>
                </a>

                <button type="button" onclick="openNewServiceModal()" class="flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 rounded-xl bg-white text-zinc-950 hover:bg-zinc-100 text-xs font-bold shadow-sm transition active:scale-95 shrink-0">
                    <i class="fa-solid fa-plus text-xs"></i>
                    <span class="hidden xs:inline">Yeni Servis Ekle</span>
                    <span class="xs:hidden">Ekle</span>
                </button>
            </div>

        </header>

        <!-- Mobil Hızlı Sekme Çubuğu (Yatay Kaydırılabilir) -->
        <nav class="md:hidden bg-[#090b10]/95 backdrop-blur-md border-b border-white/10 px-3 py-2 flex items-center gap-1.5 overflow-x-auto scrollbar-none sticky top-[49px] sm:top-[53px] z-10" aria-label="Mobil Sekmeler">
            <button type="button" onclick="switchSuperadminTab('workshops')" id="admin-mob-pill-workshops" class="superadmin-mob-pill active px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 whitespace-nowrap transition shrink-0 bg-white/10 text-white border border-white/15">
                <i class="fa-solid fa-warehouse text-[11px] text-sky-400"></i>
                <span>Servisler</span>
                <span class="px-1.5 py-0.2 rounded text-[10px] font-mono bg-white/10 text-white"><%= totalServices %></span>
            </button>
            <button type="button" onclick="switchSuperadminTab('subscriptions')" id="admin-mob-pill-subscriptions" class="superadmin-mob-pill px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 whitespace-nowrap transition shrink-0 text-zinc-400 hover:text-white hover:bg-white/5">
                <i class="fa-solid fa-chart-pie text-[11px]"></i>
                <span>Kapasite</span>
            </button>
            <button type="button" onclick="switchSuperadminTab('profile')" id="admin-mob-pill-profile" class="superadmin-mob-pill px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 whitespace-nowrap transition shrink-0 text-zinc-400 hover:text-white hover:bg-white/5">
                <i class="fa-solid fa-address-book text-[11px]"></i>
                <span>Rehber &amp; Profil</span>
            </button>
            <button type="button" onclick="switchSuperadminTab('system')" id="admin-mob-pill-system" class="superadmin-mob-pill px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 whitespace-nowrap transition shrink-0 text-zinc-400 hover:text-white hover:bg-white/5">
                <i class="fa-solid fa-server text-[11px]"></i>
                <span>Sistem</span>
                <span class="w-1.5 h-1.5 rounded-full <%= isWhatsappConnected ? 'bg-emerald-400' : 'bg-amber-400' %>"></span>
            </button>
            <button type="button" onclick="switchSuperadminTab('logs')" id="admin-mob-pill-logs" class="superadmin-mob-pill px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 whitespace-nowrap transition shrink-0 text-zinc-400 hover:text-white hover:bg-white/5">
                <i class="fa-solid fa-clock-rotate-left text-[11px]"></i>
                <span>Denetim</span>
            </button>
        </nav>

        <!-- Asıl İçerik -->
        <main class="p-3.5 sm:p-6 lg:p-8 space-y-5 sm:space-y-6 max-w-7xl w-full mx-auto">
            <%- body %>
        </main>

    </div>

    <!-- Mobil Menü & SweetAlert Toast Yardımcıları -->
    <script>
        function toggleMobileSidebar(open) {
            const sidebar = document.getElementById('mobile-sidebar');
            const backdrop = document.getElementById('mobile-sidebar-backdrop');
            if (!sidebar || !backdrop) return;
            
            if (open) {
                backdrop.classList.remove('hidden');
                sidebar.classList.remove('-translate-x-full');
                document.body.classList.add('overflow-hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        window.toast = function(title, icon = 'success') {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: icon,
                title: title,
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                background: '#0d1117',
                color: '#f8fafc',
                customClass: {
                    popup: 'border border-white/15 shadow-2xl rounded-2xl text-xs font-semibold'
                }
            });
        };
    </script>
</body>
</html>
