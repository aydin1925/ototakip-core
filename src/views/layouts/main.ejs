<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'OtoTakip — Akıllı Servis Yönetimi' %></title>
    
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Inter (Metin), Manrope (Başlık), JetBrains Mono (Plaka/Rakam) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- SweetAlert2 (Açık ve Modern Tema) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                        display: ['Manrope', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1'
                        }
                    }
                },
            },
        }
    </script>

    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #090b10; 
            color: #f8fafc; 
            -webkit-font-smoothing: antialiased;
        }

        /* Kristal Cam Menü & Kartlar */
        .nav-glass {
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .btn-elegant {
            background: linear-gradient(180deg, #1f2937 0%, #111827 100%);
            color: #ffffff;
            padding: 12px 28px;
            border-radius: 999px;
            font-weight: 600;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.15), 0 4px 14px rgba(0,0,0,0.12);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .btn-elegant:hover {
            transform: translateY(-1px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), 0 6px 20px rgba(0,0,0,0.18);
        }

        .car-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #ffffff 0%, #f3f4f6 100%);
            box-shadow: 0 2px 5px rgba(0,0,0,0.03), inset 0 1px 0 #ffffff;
            border: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Türk Plaka Tasarımı */
        .plate { 
            border: 1px solid rgba(0,0,0,0.12); 
            border-radius: 6px; 
            display: inline-flex; 
            background: #fff; 
            overflow: hidden; 
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        }
        .plate-tr { 
            background: #0284c7; 
            color: #fff; 
            padding: 2px 5px; 
            font-size: 9px; 
            font-weight: 800;
            font-family: sans-serif;
            display: flex;
            align-items: center;
        }
        .plate-num { 
            padding: 2px 7px; 
            font-size: 13px; 
            font-family: 'JetBrains Mono', monospace; 
            font-weight: 800;
            color: #111827; 
        }
        
        /* Durum Rozetleri */
        .badge { 
            display: inline-flex; 
            align-items: center; 
            padding: 2px 8px; 
            border-radius: 4px; 
            font-size: 12px; 
            font-weight: 600; 
        }
        .badge-amber { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
        .badge-blue { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
        .badge-green { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
        
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="min-h-screen flex flex-col relative overflow-x-hidden bg-[#090b10] text-slate-100 antialiased selection:bg-white selection:text-black">

    <!-- ========================================================= -->
    <!-- ARKA PLAN FOTOĞRAFI & SİNEMATİK TİTANYUM MONOKROM KATMAN   -->
    <!-- ========================================================= -->
    <div id="hero-bg-container" class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
        <!-- 1. Gerçek Atölye Fotoğrafı -->
        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat scale-100"
             style="background-image: url('/images/workshop_hero.jpg');"></div>
        
        <!-- 2. Titanyum Monokrom Dengeli Karartma Katmanı (0.65) -->
        <div class="absolute inset-0"
             style="background: rgba(8, 10, 15, 0.65);"></div>

        <!-- 3. Kenar Yumuşatma / İnce Vignette -->
        <div class="absolute inset-0"
             style="background: linear-gradient(180deg, rgba(8,10,15,0.50) 0%, transparent 20%, transparent 80%, rgba(8,10,15,0.85) 100%);"></div>
    </div>

    <!-- Üst Menü / Navbar -->
    <%- include('../partials/navbar') %>

    <!-- Sayfa İçeriği -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8 py-4 sm:py-8">
        <%- body %>
    </main>

    <!-- SweetAlert2 Global Yardımcıları (Modern ve Açık Tema) -->
    <script>
        window.toast = function(title, icon = 'success') {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: icon,
                title: title,
                showConfirmButton: false,
                timer: 3500,
                timerProgressBar: true,
                background: '#ffffff',
                color: '#111827',
                customClass: {
                    popup: 'border border-gray-200 shadow-xl rounded-2xl text-xs font-semibold'
                }
            });
        };

        window.confirmModal = async function(title, text, confirmBtnText = 'Evet, Devam Et') {
            return Swal.fire({
                title: title,
                text: text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#111827',
                cancelButtonColor: '#e5e7eb',
                confirmButtonText: confirmBtnText,
                cancelButtonText: 'Vazgeç',
                background: '#ffffff',
                color: '#111827',
                customClass: {
                    popup: 'border border-gray-200 shadow-2xl rounded-3xl',
                    cancelButton: '!text-gray-700 !font-semibold !rounded-xl',
                    confirmButton: '!rounded-xl !font-bold'
                }
            });
        };
    </script>

    <!-- Canlı SSE Dinleyicisi (WhatsApp bildirimleri geldiğinde otomatik tetikler) -->
    <script src="/js/live-stream.js"></script>
</body>
</html>
