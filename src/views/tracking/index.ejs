<div class="max-w-xl mx-auto px-4 py-6 sm:py-10">

    <% if (!vehicle) { %>
        <!-- ARAÇ BULUNAMADI KARTI -->
        <div class="rounded-3xl bg-slate-900 border border-slate-800 p-8 text-center shadow-2xl">
            <div class="w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-500 flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h2 class="text-xl font-bold text-white">Aktif Kayıt Bulunamadı</h2>
            <p class="text-sm text-slate-400 mt-2 leading-relaxed">
                <strong class="text-white font-mono uppercase tracking-wider"><%= searchedPlate %></strong> plakalı araca ait aktif bir servis işlemi bulunamadı veya araç teslim edilmiş olabilir.
            </p>
            <div class="mt-6">
                <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-semibold transition-colors">
                    <i class="fa-solid fa-arrow-left text-xs"></i>
                    <span>Anasayfaya Dön</span>
                </a>
            </div>
        </div>
    <% } else { %>
        
        <!-- ÜST SERVİS VE PLAKA BİLGİSİ -->
        <div class="text-center mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-800 text-slate-300 text-xs font-semibold border border-slate-700 mb-3">
                <i class="fa-solid fa-wrench text-orange-500"></i>
                <%= vehicle.workshop_name || 'Yetkili Oto Servis' %>
            </span>

            <div class="flex justify-center mb-2">
                <!-- Türk Plaka Grafiği -->
                <div class="inline-flex items-center bg-white text-black font-mono font-black px-4 py-1.5 rounded-lg border-2 border-slate-700 tracking-wider text-lg shadow-xl">
                    <span class="bg-blue-700 text-white text-xs px-1.5 py-0.5 rounded -ml-3 mr-2 font-sans font-bold">TR</span>
                    <%= vehicle.plate %>
                </div>
            </div>

            <h1 class="text-xl font-bold text-white"><%= vehicle.car_model %></h1>
            <p class="text-xs text-slate-400 mt-0.5">Sayın <%= vehicle.customer_name || 'Müşterimiz' %></p>
        </div>

        <!-- 4 AŞAMALI CANLI SÜREÇ KARTI -->
        <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 shadow-xl mb-6">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-5 flex items-center justify-between">
                <span>Araç Durumu</span>
                <span class="inline-flex items-center gap-1.5 text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Canlı Takip
                </span>
            </h2>

            <%
                const stages = [
                    { key: 'RECEIVED', label: 'Kabul Edildi', desc: 'Aracınız atölyeye giriş yaptı', icon: 'fa-clipboard-check' },
                    { key: 'INSPECTING', label: 'Arıza Teşhisi Yapılıyor', desc: 'Ustanız lift üzerinde kontrolleri sürdürüyor', icon: 'fa-magnifying-glass' }
                ];

                // Eğer araç şu anda parça bekliyorsa veya onaylı/bekleyen parça varsa göster
                if (vehicle.status === 'WAITING_PARTS' || (vehicle.approvals && vehicle.approvals.length > 0)) {
                    stages.push({ key: 'WAITING_PARTS', label: 'Yedek Parça Bekleniyor', desc: 'Gerekli yedek parçaların tedariği bekleniyor', icon: 'fa-boxes-packing' });
                }

                stages.push(
                    { key: 'REPAIRING', label: 'Onarım & Montajda', desc: 'Parça değişimi ve mekanik işlemler yapılıyor', icon: 'fa-wrench' },
                    { key: 'TESTING', label: 'Yol Testi & Son Kontrol', desc: 'Ustanız son güvenlik ve sürüş testini yapıyor', icon: 'fa-road' },
                    { key: 'READY', label: 'Teslimata Hazır', desc: 'Tüm işlemler bitti, aracınızı teslim alabilirsiniz', icon: 'fa-circle-check' }
                );

                const stageOrder = ['RECEIVED', 'INSPECTING', 'WAITING_PARTS', 'REPAIRING', 'TESTING', 'READY', 'DELIVERED'];
                const currentIdx = stageOrder.indexOf(vehicle.status);
            %>

            <div class="space-y-3.5">
                <% stages.forEach((s) => { 
                    const sIdx = stageOrder.indexOf(s.key);
                    const isPassed = currentIdx > sIdx || vehicle.status === 'DELIVERED';
                    const isCurrent = vehicle.status === s.key;
                %>
                    <div class="flex items-start gap-4 p-3.5 rounded-2xl transition-all <%= isCurrent ? 'bg-orange-600/10 border border-orange-500/30 ring-1 ring-orange-500/20' : (isPassed ? 'bg-slate-950/60' : 'opacity-40') %>">
                        <div class="w-9 h-9 rounded-xl flex items-center justify-center text-sm shrink-0 <%= isCurrent ? 'bg-orange-500 text-white shadow-lg shadow-orange-500/30' : (isPassed ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-800 text-slate-500') %>">
                            <i class="fa-solid <%= s.icon %>"></i>
                        </div>
                        <div class="flex-1">
                            <div class="text-sm font-bold <%= isCurrent ? 'text-orange-400' : (isPassed ? 'text-white' : 'text-slate-400') %>">
                                <%= s.label %>
                            </div>
                            <div class="text-xs text-slate-400 mt-0.5"><%= s.desc %></div>
                        </div>
                        <% if (isCurrent) { %>
                            <span class="text-[10px] bg-orange-500 text-slate-950 font-bold px-2 py-0.5 rounded-md uppercase tracking-wider self-center">
                                AKTİF
                            </span>
                        <% } else if (isPassed) { %>
                            <i class="fa-solid fa-check text-emerald-500 text-xs self-center"></i>
                        <% } %>
                    </div>
                <% }); %>
            </div>

            <!-- Hedef Teslimat Zamanı -->
            <% if (vehicle.estimated_delivery) { %>
                <div class="mt-5 pt-4 border-t border-slate-800 flex items-center justify-between text-xs">
                    <span class="text-slate-400">Hedef Teslim Zamanı:</span>
                    <span class="font-bold text-white bg-slate-950 px-2.5 py-1 rounded-lg border border-slate-800">
                        <%= vehicle.estimated_delivery %>
                    </span>
                </div>
            <% } %>
        </div>

        <!-- WHATSAPP PARÇA VE İŞLEM ONAY BÖLÜMÜ -->
        <% if (vehicle.approvals && vehicle.approvals.length > 0) { %>
            <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 shadow-xl mb-6">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-2">
                    <i class="fa-brands fa-whatsapp text-emerald-500"></i>
                    <span>Parça Değişim & Fiyat Onayları</span>
                </h2>

                <div class="space-y-3">
                    <% vehicle.approvals.forEach(appr => { %>
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <div class="text-sm font-bold text-white"><%= appr.part_name %></div>
                                    <div class="text-xs text-slate-400 mt-1"><%= appr.note %></div>
                                </div>

                                <!-- Onay Durum Rozeti -->
                                <% if (appr.status === 'APPROVED') { %>
                                    <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold shrink-0">
                                        ✓ Onaylandı
                                    </span>
                                <% } else if (appr.status === 'PENDING') { %>
                                    <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-bold shrink-0 animate-pulse">
                                        Onay Bekliyor
                                    </span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20 text-xs font-bold shrink-0">
                                        İptal Edildi
                                    </span>
                                <% } %>
                            </div>

                            <% if (appr.status === 'PENDING') { %>
                                <div class="mt-3 p-2.5 rounded-xl bg-amber-500/5 border border-amber-500/20 text-[11px] text-amber-300/80 flex items-center gap-2">
                                    <i class="fa-brands fa-whatsapp text-emerald-400 text-sm"></i>
                                    <span>WhatsApp'tan ustanıza <strong>"ONAYLIYORUM"</strong> yazarak bu parçayı anında onaylayabilirsiniz.</span>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } %>

        <!-- DİJİTAL SERVİS FİŞİ & HESAP ÖZETİ (FATURA KARTI) -->
        <% if (vehicle.receipt) { %>
            <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 shadow-xl mb-6 relative overflow-hidden">
                <!-- Üst Fiş Başlığı -->
                <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-lg border border-emerald-500/20">
                            ✓ Onaylı Servis Fişi
                        </span>
                        <h3 class="text-base font-bold text-white mt-2 flex items-center gap-2">
                            <i class="fa-solid fa-receipt text-emerald-400"></i>
                            <span>Hesap & Masraf Özeti</span>
                        </h3>
                    </div>
                    <div class="text-right">
                        <div class="text-[11px] text-slate-400 font-medium">Toplam Tutar</div>
                        <div class="text-xl sm:text-2xl font-black text-emerald-400 font-mono">
                            <%= Number(vehicle.receipt.total_amount).toLocaleString('tr-TR') %> TL
                        </div>
                    </div>
                </div>

                <!-- Fiş Kalemleri -->
                <div class="space-y-2 mb-4">
                    <% if (vehicle.receipt.items && vehicle.receipt.items.length > 0) { %>
                        <% vehicle.receipt.items.forEach(it => { %>
                            <div class="flex items-center justify-between py-2 px-3 rounded-xl bg-slate-950 border border-slate-800/80 text-xs">
                                <span class="text-slate-300 font-medium flex items-center gap-2">
                                    <i class="fa-solid fa-wrench text-orange-400 text-[10px]"></i>
                                    <%= it.name %>
                                </span>
                                <span class="font-mono font-bold text-white"><%= Number(it.price).toLocaleString('tr-TR') %> TL</span>
                            </div>
                        <% }); %>
                    <% } %>

                    <% if (vehicle.receipt.labor_cost > 0) { %>
                        <div class="flex items-center justify-between py-2 px-3 rounded-xl bg-slate-950 border border-slate-800/80 text-xs">
                            <span class="text-slate-300 font-medium flex items-center gap-2">
                                <i class="fa-solid fa-user-gear text-cyan-400 text-[10px]"></i>
                                Periyodik Bakım & Usta İşçiliği
                            </span>
                            <span class="font-mono font-bold text-white"><%= Number(vehicle.receipt.labor_cost).toLocaleString('tr-TR') %> TL</span>
                        </div>
                    <% } %>
                </div>

                <% if (vehicle.receipt.notes) { %>
                    <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80 text-xs text-slate-400">
                        <strong class="text-slate-300">Garanti / Not:</strong> <%= vehicle.receipt.notes %>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- HİZMET VE PARÇA FOTOĞRAFLARI (EKSPERTİZ KANITI) -->
        <% if (vehicle.photos && vehicle.photos.length > 0) { %>
            <div class="rounded-3xl bg-slate-900 border border-slate-800 p-6 shadow-xl mb-6">
                <h3 class="text-base font-bold text-white mb-1 flex items-center gap-2">
                    <i class="fa-solid fa-camera text-sky-400"></i>
                    <span>Hizmet & Parça Fotoğrafları</span>
                </h3>
                <p class="text-xs text-slate-400 mb-4">Ustanızın araç üzerinde tespit ettiği ve değiştirdiği parçaların görsel kanıtları</p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <% vehicle.photos.forEach(p => { %>
                        <div class="rounded-2xl bg-slate-950 border border-slate-800 overflow-hidden shadow">
                            <a href="<%= p.photo_path %>" target="_blank" class="block relative group">
                                <img src="<%= p.photo_path %>" alt="<%= p.caption || 'Parça Fotoğrafı' %>" class="w-full h-44 object-cover group-hover:opacity-90 transition">
                                <div class="absolute bottom-2 right-2 px-2.5 py-1 rounded-lg bg-slate-950/80 backdrop-blur-sm text-[10px] text-white font-semibold flex items-center gap-1 border border-slate-700">
                                    <i class="fa-solid fa-expand"></i> Büyüt
                                </div>
                            </a>
                            <div class="p-3">
                                <div class="text-xs font-semibold text-slate-200"><%= p.caption || 'Servis Fotoğrafı' %></div>
                                <div class="text-[10px] text-slate-500 mt-1 flex items-center gap-1">
                                    <i class="fa-regular fa-clock"></i> <%= p.created_at %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } %>

        <!-- USTA İLE WHATSAPP İLETİŞİM BUTONU -->
        <div class="text-center">
            <a 
                href="https://wa.me/<%= vehicle.workshop_phone || '' %>?text=Merhaba,%20<%= vehicle.plate %>%20aracımın%20durumu%20hakkında%20bilgi%20almak%20istiyorum."
                target="_blank"
                class="w-full py-3.5 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/20 transition-all flex items-center justify-center gap-2"
            >
                <i class="fa-brands fa-whatsapp text-lg"></i>
                <span>Ustanıza WhatsApp'tan Yazın</span>
            </a>
        </div>

    <% } %>

</div>
