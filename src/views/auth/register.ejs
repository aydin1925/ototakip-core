<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center p-4 sm:p-6 lg:p-8">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-2xl relative overflow-hidden">
        
        <!-- Arka Plan Dekoratif Işıltı -->
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-orange-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Başlık -->
        <div class="text-center mb-8">
            <div class="w-12 h-12 rounded-2xl bg-orange-600/10 border border-orange-500/20 text-orange-500 flex items-center justify-center mx-auto mb-3 text-xl">
                <i class="fa-solid fa-wrench"></i>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-white">Servis Kaydı Aç</h1>
            <p class="text-sm text-slate-400 mt-1">OtoTakip ile liftlerinizi ve onayları dijitalleştirin</p>
        </div>

        <!-- Hata Bildirimi (Varsa) -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center gap-3">
                <i class="fa-solid fa-circle-exclamation text-rose-500"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Kayıt Formu -->
        <form action="/register" method="POST" class="space-y-4">
            <div>
                <label for="workshop_name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Atölye / Dükkan Adı *</label>
                <input 
                    type="text" 
                    name="workshop_name" 
                    id="workshop_name" 
                    required 
                    placeholder="Örn: Yılmaz Oto Servis" 
                    value="<%= typeof formData !== 'undefined' && formData.workshop_name ? formData.workshop_name : '' %>"
                    class="w-full px-4 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-white placeholder-slate-600 text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all"
                >
            </div>

            <div>
                <label for="owner_name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Usta / Yetkili Adı *</label>
                <input 
                    type="text" 
                    name="owner_name" 
                    id="owner_name" 
                    required 
                    placeholder="Örn: Ahmet Usta" 
                    value="<%= typeof formData !== 'undefined' && formData.owner_name ? formData.owner_name : '' %>"
                    class="w-full px-4 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-white placeholder-slate-600 text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all"
                >
            </div>

            <div>
                <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Telefon Numarası *</label>
                <input 
                    type="text" 
                    name="phone" 
                    id="phone" 
                    required 
                    placeholder="0532 111 22 33" 
                    value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                    class="w-full px-4 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-white placeholder-slate-600 text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all"
                >
            </div>

            <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">E-Posta (İsteğe Bağlı)</label>
                <input 
                    type="email" 
                    name="email" 
                    id="email" 
                    placeholder="servis@ornek.com" 
                    value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                    class="w-full px-4 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-white placeholder-slate-600 text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all"
                >
            </div>

            <div>
                <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Şifre (En az 6 karakter) *</label>
                <input 
                    type="password" 
                    name="password" 
                    id="password" 
                    required 
                    minlength="6"
                    placeholder="••••••••" 
                    class="w-full px-4 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-white placeholder-slate-600 text-sm focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all"
                >
            </div>

            <button 
                type="submit" 
                class="w-full py-3.5 px-4 rounded-xl bg-orange-600 hover:bg-orange-500 text-white font-semibold text-sm shadow-lg shadow-orange-600/30 transition-all flex items-center justify-center gap-2 mt-4"
            >
                <span>Servisi Kaydet ve Başla</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
        </form>

        <!-- Giriş Yönlendirmesi -->
        <div class="text-center mt-6 pt-6 border-t border-slate-800/80">
            <p class="text-xs text-slate-400">
                Zaten hesabınız var mı? 
                <a href="/login" class="text-orange-500 hover:text-orange-400 font-semibold ml-1">Giriş Yap</a>
            </p>
        </div>

    </div>
</div>
