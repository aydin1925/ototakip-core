<div class="min-h-[calc(100vh-12rem)] flex items-center justify-center py-6 sm:py-12">
    <div class="w-full max-w-md rounded-3xl p-6 sm:p-8 relative border shadow-2xl text-white space-y-4 backdrop-blur-xl" style="background: rgba(15, 23, 42, 0.50); border-color: rgba(255, 255, 255, 0.20);">
        
        <!-- Başlık -->
        <div class="text-center mb-6">
            <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/15 text-white flex items-center justify-center mx-auto mb-3 text-xl shadow-inner">
                <i class="fa-solid fa-wrench"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl font-display font-extrabold tracking-tight text-white">Servis Kaydı Aç</h1>
            <p class="text-xs sm:text-sm text-slate-300 mt-1">OtoTakip ile liftlerinizi ve WhatsApp onaylarını yönetin</p>
        </div>

        <!-- Hata Bildirimi (Varsa) -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-4 p-4 rounded-xl bg-rose-500/20 border border-rose-500/30 text-rose-300 text-xs sm:text-sm flex items-center gap-3">
                <i class="fa-solid fa-circle-exclamation text-rose-400 text-base shrink-0"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Kayıt Formu -->
        <form action="/register" method="POST" class="space-y-4">
            <div>
                <label for="workshop_name" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Atölye / Dükkan Adı *</label>
                <input 
                    type="text" 
                    name="workshop_name" 
                    id="workshop_name" 
                    required 
                    placeholder="Örn: Yılmaz Oto Servis" 
                    value="<%= typeof formData !== 'undefined' && formData.workshop_name ? formData.workshop_name : '' %>"
                    class="w-full px-4 py-2.5 bg-black/50 border border-white/15 rounded-xl text-white placeholder-slate-400 text-sm focus:border-white focus:outline-none transition-colors"
                >
            </div>

            <div>
                <label for="owner_name" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Usta / Yetkili Adı *</label>
                <input 
                    type="text" 
                    name="owner_name" 
                    id="owner_name" 
                    required 
                    placeholder="Örn: Ahmet Usta" 
                    value="<%= typeof formData !== 'undefined' && formData.owner_name ? formData.owner_name : '' %>"
                    class="w-full px-4 py-2.5 bg-black/50 border border-white/15 rounded-xl text-white placeholder-slate-400 text-sm focus:border-white focus:outline-none transition-colors"
                >
            </div>

            <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Telefon Numarası (WhatsApp) *</label>
                <input 
                    type="text" 
                    name="phone" 
                    id="phone" 
                    required 
                    placeholder="0532 111 22 33" 
                    value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                    class="w-full px-4 py-2.5 bg-black/50 border border-white/15 rounded-xl text-white placeholder-slate-400 text-sm focus:border-white focus:outline-none transition-colors"
                >
            </div>

            <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">E-Posta (İsteğe Bağlı)</label>
                <input 
                    type="email" 
                    name="email" 
                    id="email" 
                    placeholder="servis@ornek.com" 
                    value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                    class="w-full px-4 py-2.5 bg-black/50 border border-white/15 rounded-xl text-white placeholder-slate-400 text-sm focus:border-white focus:outline-none transition-colors"
                >
            </div>

            <div>
                <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Şifre (En az 6 karakter) *</label>
                <input 
                    type="password" 
                    name="password" 
                    id="password" 
                    required 
                    minlength="6"
                    placeholder="••••••••" 
                    class="w-full px-4 py-2.5 bg-black/50 border border-white/15 rounded-xl text-white placeholder-slate-400 text-sm focus:border-white focus:outline-none transition-colors"
                >
            </div>

            <button 
                type="submit" 
                class="w-full py-3 px-4 rounded-xl bg-white hover:bg-slate-100 text-slate-950 font-bold text-sm shadow-md transition-all flex items-center justify-center gap-2 mt-4 cursor-pointer hover:scale-[1.01]"
            >
                <span>Servisi Kaydet ve Başla</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
        </form>

        <!-- Giriş Yönlendirmesi -->
        <div class="text-center mt-6 pt-5 border-t border-white/10">
            <p class="text-xs text-slate-400">
                Zaten kayıtlı mısınız? 
                <a href="/login" class="text-white hover:text-sky-300 font-bold ml-1 transition-colors">Usta Girişi Yapın</a>
            </p>
        </div>

    </div>
</div>
