<div class="min-h-[calc(100vh-12rem)] flex items-center justify-center py-6 sm:py-12">
    <div class="w-full max-w-md rounded-3xl p-6 sm:p-8 relative border shadow-2xl text-white space-y-4 backdrop-blur-xl" style="background: rgba(15, 23, 42, 0.50); border-color: rgba(255, 255, 255, 0.20);">
        
        <!-- Başlık -->
        <div class="text-center mb-6">
            <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/15 text-white flex items-center justify-center mx-auto mb-3 text-xl shadow-inner">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl font-display font-extrabold tracking-tight text-white">Usta Girişi</h1>
            <p class="text-xs sm:text-sm text-slate-300 mt-1">Servis ve lift paneline erişmek için oturum açın</p>
        </div>

        <!-- Hata Bildirimi (Varsa) -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-4 p-4 rounded-xl bg-rose-500/20 border border-rose-500/30 text-rose-300 text-xs sm:text-sm flex items-center gap-3">
                <i class="fa-solid fa-circle-exclamation text-rose-400 text-base shrink-0"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <!-- Giriş Formu -->
        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label for="identifier" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Telefon veya E-Posta</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                        <i class="fa-solid fa-phone text-xs"></i>
                    </span>
                    <input 
                        type="text" 
                        name="identifier" 
                        id="identifier" 
                        required 
                        placeholder="0532 111 22 33 veya usta@servis.com" 
                        value="<%= typeof formData !== 'undefined' && formData.identifier ? formData.identifier : '' %>"
                        class="w-full pl-10 pr-4 py-2.5 bg-black/50 border border-white/15 rounded-xl text-white placeholder-slate-400 text-sm focus:border-white focus:outline-none transition-colors"
                    >
                </div>
            </div>

            <div>
                <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-1.5">Şifre</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                        <i class="fa-solid fa-key text-xs"></i>
                    </span>
                    <input 
                        type="password" 
                        name="password" 
                        id="password" 
                        required 
                        placeholder="••••••••" 
                        class="w-full pl-10 pr-4 py-2.5 bg-black/50 border border-white/15 rounded-xl text-white placeholder-slate-400 text-sm focus:border-white focus:outline-none transition-colors"
                    >
                </div>
            </div>

            <button 
                type="submit" 
                class="w-full py-3 px-4 rounded-xl bg-white hover:bg-slate-100 text-slate-950 font-bold text-sm shadow-md transition-all flex items-center justify-center gap-2 mt-4 cursor-pointer hover:scale-[1.01]"
            >
                <span>Giriş Yap</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
        </form>

        <!-- Kayıt Yönlendirmesi -->
        <div class="text-center mt-6 pt-5 border-t border-white/10">
            <p class="text-xs text-slate-400">
                Henüz servis kaydınız yok mu? 
                <a href="/register" class="text-white hover:text-sky-300 font-bold ml-1 transition-colors">Hemen Kaydolun</a>
            </p>
        </div>

    </div>
</div>
